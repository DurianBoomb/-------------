{
	"bsonType": "object",
	"required": ["name"],
	"permission": {
		"read": true,
		"create": "auth.uid != null",
		"update": "auth.uid != null",
		"delete": "auth.uid != null"
	},
	"properties": {
		"_id": {
			"description": "标签ID，系统自动生成"
		},
		"name": {
			"bsonType": "string",
			"description": "标签名，如\"确诊为烤肠\"。注意：不设唯一约束，同名标签可共存。",
			"trim": "both",
			"maxLength": 50
		},
		"category": {
			"bsonType": "string",
			"description": "所属分类 ID（关联 survey-categories._id），用户生成标签可留空",
			"trim": "both"
		},
		"emoji": {
			"bsonType": "string",
			"description": "标签 emoji，如 \"🌭\"",
			"trim": "both",
			"maxLength": 10
		},
		"description": {
			"bsonType": "string",
			"description": "标签简短描述",
			"trim": "both",
			"maxLength": 500
		},
		"popularity": {
			"bsonType": "int",
			"description": "热度值，初始 0，后续按答题次数递增",
			"defaultValue": 0,
			"minimum": 0
		},
		"rarity": {
			"bsonType": "string",
			"description": "稀有度。handmade0 不可被搜索和标签池刷新（私有），其余等级均为公开可见",
			"defaultValue": "common",
			"enum": [
				{ "value": "handmade0", "text": "手工0（私有）" },
				{ "value": "common", "text": "普通" },
				{ "value": "rare", "text": "稀有" },
				{ "value": "mythic", "text": "神话" },
				{ "value": "epic", "text": "史诗" },
				{ "value": "legendary", "text": "传奇" },
				{ "value": "handmade1", "text": "手工1" },
				{ "value": "handmade2", "text": "手工2" },
				{ "value": "handmade3", "text": "手工3" },
				{ "value": "darkgold", "text": "暗金" }
			]
		},
		"source": {
			"bsonType": "string",
			"description": "标签来源：system 预置 / user 用户生成",
			"defaultValue": "system",
			"enum": [
				{ "value": "system", "text": "预置" },
				{ "value": "user", "text": "用户生成" }
			]
		},
		"creatorId": {
			"bsonType": "string",
			"description": "创建者用户 ID（用户生成标签时记录，预置标签留空）",
			"trim": "both"
		},
		"surveyId": {
			"bsonType": "string",
			"description": "关联的问卷 _id（用户生成标签时记录，用于标签池跳转精准定位）",
			"trim": "both"
		},
		"clickCount": {
			"bsonType": "int",
			"description": "外部用户点击累计次数，驱动等级晋升和精选发疯池排序",
			"defaultValue": 0,
			"minimum": 0
		},
		"surveyCount": {
			"bsonType": "int",
			"description": "该标签下的问卷数量（冗余字段）",
			"defaultValue": 0,
			"minimum": 0
		},
		"create_date": {
			"bsonType": "timestamp",
			"description": "创建时间",
			"defaultValue": {
				"$env": "now"
			}
		}
	},
	"indexes": [
		{
			"name": "rarity",
			"fields": [
				{
					"name": "rarity",
					"direction": "asc"
				}
			]
		},
		{
			"name": "creatorId",
			"fields": [
				{
					"name": "creatorId",
					"direction": "asc"
				}
			]
		},
		{
			"name": "popularity",
			"fields": [
				{
					"name": "popularity",
					"direction": "desc"
				}
			]
		}
	]
}
