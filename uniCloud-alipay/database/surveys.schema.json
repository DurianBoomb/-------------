{
	"bsonType": "object",
	"required": ["tagName", "dims", "qs", "resultTypes"],
	"permission": {
		"read": true,
		"create": true,
		"update": "auth.uid != null",
		"delete": "auth.uid != null"
	},
	"properties": {
		"_id": {
			"description": "问卷ID，系统自动生成"
		},
		"tagName": {
			"bsonType": "string",
			"description": "关联的标签名，如\"确诊为烤肠\"。答题页头部直接使用此字段展示。",
			"trim": "both",
			"maxLength": 50
		},
		"dims": {
			"bsonType": "array",
			"description": "维度列表，3-7 个字符串",
			"minItems": 3,
			"maxItems": 7,
			"items": {
				"bsonType": "string",
				"maxLength": 50,
				"trim": "both"
			}
		},
		"qs": {
			"bsonType": "array",
			"description": "题目数组（Coze 友好版，无索引无分数）",
			"items": {
				"bsonType": "object",
				"required": ["title", "dim"],
				"properties": {
					"title": {
						"bsonType": "string",
						"description": "题目文本",
						"trim": "both",
						"maxLength": 500
					},
					"dim": {
						"bsonType": "string",
						"description": "关联的维度名，必须在 dims 数组中",
						"trim": "both",
						"maxLength": 50
					}
				}
			}
		},
		"resultTypes": {
			"bsonType": "array",
			"description": "结果类型数组",
			"minItems": 1,
			"maxItems": 35,
			"items": {
				"bsonType": "object",
				"required": ["name", "emoji", "desc"],
				"properties": {
					"name": {
						"bsonType": "string",
						"description": "结果类型名称",
						"trim": "both",
						"maxLength": 100
					},
					"emoji": {
						"bsonType": "string",
						"description": "结果类型 emoji，如\"🌭\"，前端放大展示",
						"trim": "both",
						"maxLength": 10
					},
					"emojiBg": {
						"bsonType": "string",
						"description": "结果卡片背景色，Coze 给出的颜色值如\"#FFE4B5\"，前端渲染为渐变或纯色背景",
						"trim": "both",
						"maxLength": 50
					},
					"desc": {
						"bsonType": "string",
						"description": "结果类型描述",
						"trim": "both",
						"maxLength": 5000
					},
					"image": {
						"bsonType": "string",
						"description": "结果配图 URL，支持 cloud:// 云存储 fileID 或普通 HTTPS URL。cloud:// 格式前端自动转为临时链接",
						"trim": "both",
						"maxLength": 500
					},
					"match": {
						"bsonType": "string",
						"description": "关联的维度名（普通问卷使用），得分最高的维度匹配此结果类型",
						"trim": "both",
						"maxLength": 50
					},
					"profile": {
						"bsonType": "array",
						"description": "五维特征向量（特殊问卷使用），每个分量 [0, 100]，与 raw 同量纲。有此字段则走向量匹配（欧几里得最近邻），无则走 match 单维度匹配",
						"items": { "bsonType": "number" }
					}
				}
			}
		},
		"status": {
			"bsonType": "string",
			"description": "问卷状态：active / disabled。预置问卷默认不填，Coze 生成的默认 active",
			"enum": [
				{ "value": "active", "text": "启用" },
				{ "value": "disabled", "text": "已禁用" }
			]
		},
		"creatorId": {
			"bsonType": "string",
			"description": "创建者用户 ID（用户生成问卷时记录，预置问卷留空）",
			"trim": "both"
		},
		"create_date": {
			"bsonType": "timestamp",
			"description": "创建时间",
			"defaultValue": {
				"$env": "now"
			}
		},
		"clickCount": {
			"bsonType": "int",
			"description": "外部用户打开答题页的累计次数，达到 101 后标签晋升 Artifact 1",
			"defaultValue": 0,
			"minimum": 0
		},
		"source": {
			"bsonType": "string",
			"description": "问卷来源：coze（用户AI生成）或空（系统预置）",
			"enum": [
				{ "value": "coze", "text": "用户Coze生成" }
			]
		}
	},
	"indexes": [
		{
			"name": "creatorId",
			"fields": [
				{
					"name": "creatorId",
					"direction": "asc"
				}
			]
		},
		{
			"name": "tagName_creatorId_unique",
			"unique": true,
			"fields": [
				{
					"name": "tagName",
					"direction": "asc"
				},
				{
					"name": "creatorId",
					"direction": "asc"
				}
			]
		}
	]
}
