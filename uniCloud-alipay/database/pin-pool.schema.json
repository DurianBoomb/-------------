{
	"bsonType": "object",
	"required": ["surveyId", "userId", "surveyTitle", "surveyCover", "weight", "createdAt", "expireAt", "senioritySnapshot", "haloActive", "isGreenChannel"],
	"permission": {
		"read": true,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "自动生成，格式 pin_{时间戳}_{4位随机数}"
		},
		"surveyId": {
			"bsonType": "string",
			"description": "问卷唯一标识"
		},
		"userId": {
			"bsonType": "string",
			"description": "所属用户标识"
		},
		"surveyTitle": {
			"bsonType": "string",
			"description": "问卷标题，入池时从问卷数据冗余写入",
			"maxLength": 100,
			"trim": "both"
		},
		"surveyCover": {
			"bsonType": "string",
			"description": "问卷封面图片 URL，入池时冗余写入"
		},
		"weight": {
			"bsonType": "int",
			"description": "当前综合权重值"
		},
		"createdAt": {
			"bsonType": "timestamp",
			"description": "入池时间戳"
		},
		"expireAt": {
			"bsonType": "timestamp",
			"description": "过期时间 = createdAt + 13分钟"
		},
		"senioritySnapshot": {
			"bsonType": "int",
			"description": "入池瞬间用户的曝光资历快照值"
		},
		"haloActive": {
			"bsonType": "bool",
			"description": "登场光环标记，true 表示光环生效中"
		},
		"isGreenChannel": {
			"bsonType": "bool",
			"description": "是否通过绿色通道入池"
		}
	},
	"index": [
		{
			"name": "idx_expireAt",
			"field": "expireAt",
			"type": "regular"
		},
		{
			"name": "idx_userId",
			"field": "userId",
			"type": "regular"
		}
	]
}
