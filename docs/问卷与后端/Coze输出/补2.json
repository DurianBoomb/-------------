"{\"questionnaire\": null, \"questionnaires\": [{\"prompt_version\": \"2.0\", \"tag\": \"恋爱脑切除手术恢复期\", \"title\": \"你的术后幻痛，到几级了？\", \"dims\": [\"关键词触发敏感度\", \"手抖行为频率\", \"自我诊断倾向\", \"回忆闪回强度\", \"康复进度认知偏差\"], \"qs\": [{\"title\": \"看到“我们”“以后”“永远”这种词，心里还是会咯噔一下。\", \"dim\": \"关键词触发敏感度\"}, {\"title\": \"刷到别人秀恩爱的朋友圈，会下意识快速划过去。\", \"dim\": \"关键词触发敏感度\"}, {\"title\": \"听到共同朋友无意中提到TA的近况，耳朵会立刻竖起来。\", \"dim\": \"关键词触发敏感度\"}, {\"title\": \"深夜点开对方社交主页，看两眼又火速关掉。\", \"dim\": \"手抖行为频率\"}, {\"title\": \"备忘录里还存着没发出去的小作文，偶尔会翻出来看。\", \"dim\": \"手抖行为频率\"}, {\"title\": \"看到适合TA的东西，第一反应还是想分享，然后愣住。\", \"dim\": \"手抖行为频率\"}, {\"title\": \"会反复分析自己“是不是已经好了”“这算不算复发”。\", \"dim\": \"自我诊断倾向\"}, {\"title\": \"看到情感博主讲“放下”的帖子，会忍不住对号入座。\", \"dim\": \"自我诊断倾向\"}, {\"title\": \"朋友问起近况，我会说“在康复了”，但心里没底。\", \"dim\": \"自我诊断倾向\"}, {\"title\": \"路过一起去过的店，脑子里会自动播放当时的画面。\", \"dim\": \"回忆闪回强度\"}, {\"title\": \"听到某首歌的前奏，会瞬间被拉回特定的情绪里。\", \"dim\": \"回忆闪回强度\"}, {\"title\": \"梦到和好了，醒来会对着天花板发几分钟的呆。\", \"dim\": \"回忆闪回强度\"}, {\"title\": \"觉得自己白天已经刀枪不入了，晚上又破防。\", \"dim\": \"康复进度认知偏差\"}, {\"title\": \"以为删干净了所有东西就是痊愈，结果发现还有漏网之鱼。\", \"dim\": \"康复进度认知偏差\"}, {\"title\": \"朋友都说我走出来了，只有我自己知道还有余震。\", \"dim\": \"康复进度认知偏差\"}], \"resultTypes\": [{\"name\": \"高度敏感型\", \"emoji\": \"🎯\", \"emojiBg\": \"#FF6B6B\", \"desc\": \"关键词雷达全开，一点风吹草动就能触发警报。表面风平浪静，内心已上演完一部BE美学电影。\", \"match\": \"关键词触发敏感度\"}, {\"name\": \"间歇性手抖\", \"emoji\": \"🫨\", \"emojiBg\": \"#FFD93D\", \"desc\": \"理智告诉你别点，但手指有自己的想法。在“我就看看”和“我真该死啊”之间反复横跳。\", \"match\": \"手抖行为频率\"}, {\"name\": \"自我观察员\", \"emoji\": \"🔍\", \"emojiBg\": \"#6BCB77\", \"desc\": \"每天给自己做情绪活检，试图从每一个微小的波动里分析出康复进度。是病人，也是自己的主治医（庸医）。\", \"match\": \"自我诊断倾向\"}, {\"name\": \"闪回体验官\", \"emoji\": \"🎞️\", \"emojiBg\": \"#4D96FF\", \"desc\": \"回忆像不受控的走马灯，在最放松的时刻突然袭击。大脑的某个分区，似乎还停留在过去时。\", \"match\": \"回忆闪回强度\"}, {\"name\": \"进度错觉者\", \"emoji\": \"📈\", \"emojiBg\": \"#9B59B6\", \"desc\": \"康复进度条自己画，时快时慢，时进时退。在“我好了”和“我装的”之间，没有中间态。\", \"match\": \"康复进度认知偏差\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"下辈子投胎成什么APP\", \"title\": \"你下辈子会投胎成什么APP？\", \"dims\": [\"用户粘性指数\", \"功能迭代速度\", \"内存占用率\", \"广告变现浓度\", \"社交生态位\", \"崩溃闪退频率\"], \"qs\": [{\"title\": \"朋友约我出门，我经常说“下次一定”，然后继续刷手机。\", \"dim\": \"用户粘性指数\"}, {\"title\": \"手机电量低于20%的焦虑，远比不上“没网了”的恐慌。\", \"dim\": \"用户粘性指数\"}, {\"title\": \"我觉得一天不看手机，世界也不会怎么样，但我就是做不到。\", \"dim\": \"用户粘性指数\"}, {\"title\": \"我热衷于尝试各种新功能，哪怕旧功能还没用明白。\", \"dim\": \"功能迭代速度\"}, {\"title\": \"看到“新版本更新”的提示，我会第一时间点下去。\", \"dim\": \"功能迭代速度\"}, {\"title\": \"我经常觉得自己的生活/工作方式需要“版本大更新”。\", \"dim\": \"功能迭代速度\"}, {\"title\": \"我手机里存了很多“以后可能用得上”的截图和文件，从没整理过。\", \"dim\": \"内存占用率\"}, {\"title\": \"同时处理好几件事时，我经常感觉自己的“运行内存”不够了。\", \"dim\": \"内存占用率\"}, {\"title\": \"我的待办事项列表很长，但真正在做的没几件。\", \"dim\": \"内存占用率\"}, {\"title\": \"我偶尔会想，如果发朋友圈/动态能直接赚钱就好了。\", \"dim\": \"广告变现浓度\"}, {\"title\": \"我对“跳过广告”的按钮位置了如指掌。\", \"dim\": \"广告变现浓度\"}, {\"title\": \"我觉得自己的某些技能或时间，其实可以明码标价。\", \"dim\": \"广告变现浓度\"}, {\"title\": \"在群里，我更多是围观，而不是那个带头聊天的。\", \"dim\": \"社交生态位\"}, {\"title\": \"我能通过朋友圈点赞，默默了解很多人的近况。\", \"dim\": \"社交生态位\"}, {\"title\": \"我觉得维持一段“点赞之交”的关系，比深交更省心。\", \"dim\": \"社交生态位\"}, {\"title\": \"压力大的时候，我会有“干脆摆烂关机”的念头。\", \"dim\": \"崩溃闪退频率\"}, {\"title\": \"我经历过因为一点小事，一整天情绪都“加载不出来”的情况。\", \"dim\": \"崩溃闪退频率\"}, {\"title\": \"当太多人同时找我时，我的反应会变慢，甚至想“无响应”。\", \"dim\": \"崩溃闪退频率\"}], \"resultTypes\": [{\"name\": \"国民级应用\", \"emoji\": \"👑\", \"emojiBg\": \"#FFD93D\", \"desc\": \"你是那种装机必备、老少皆知的APP。社交关系网复杂且牢固，用户粘性极高，但也承载了过多的期待和内存。生活热闹，但偶尔也想卸载重装。\", \"match\": \"用户粘性指数\"}, {\"name\": \"敏捷开发版\", \"emoji\": \"⚡\", \"emojiBg\": \"#6BCEF5\", \"desc\": \"你的版本号更新得比日历还快。永远在优化，永远有想法，对“新功能”有无穷的探索欲。人生是Beta版，充满可能，但也可能因为迭代太快而留下一些没修完的Bug。\", \"match\": \"功能迭代速度\"}, {\"name\": \"内存吞噬者\", \"emoji\": \"🐘\", \"emojiBg\": \"#95E1D3\", \"desc\": \"你的存在感很强，占用空间也巨大。心里装着太多“以后再说”的事和情绪缓存，导致运行起来有时会卡顿。是重要的基础设施，但急需一次深度的“垃圾清理”。\", \"match\": \"内存占用率\"}, {\"name\": \"商业化Pro版\", \"emoji\": \"💰\", \"emojiBg\": \"#FF9F43\", \"desc\": \"你的功能明确，且懂得将自己的价值变现。人生目标清晰，讲究效率和投入产出比。可能少了点“用爱发电”的浪漫，但多了份稳定运行的底气。\", \"match\": \"广告变现浓度\"}, {\"name\": \"社交组件\", \"emoji\": \"🔗\", \"emojiBg\": \"#C9C9C9\", \"desc\": \"你不是平台本身，而是其中的一个链接或小组件。善于在已有的社交生态里找到自己的位置，通过点赞、转发、评论维持着微妙的连接。存在感不强，但不可或缺。\", \"match\": \"社交生态位\"}, {\"name\": \"测试版不稳定分支\", \"emoji\": \"⚠️\", \"emojiBg\": \"#FF6B6B\", \"desc\": \"你的运行状态时好时坏，情绪和能量条波动较大。在高压或复杂环境下容易“闪退”或“崩溃”。需要更多的调试、宽容的测试环境，以及一个稳定的热更新包。\", \"match\": \"崩溃闪退频率\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"用超市购物车测人生轨迹\", \"title\": \"你的购物车，暴露了你什么人生轨迹？\", \"dims\": [\"必需品纯度\", \"享乐品密度\", \"决策犹豫度\", \"路径规划性\", \"空转哲学值\"], \"qs\": [{\"title\": \"我进超市前会列个清单，买完就走，绝不多看。\", \"dim\": \"必需品纯度\"}, {\"title\": \"看到“第二件半价”，我会想“我用得上吗”，而不是“好划算”。\", \"dim\": \"必需品纯度\"}, {\"title\": \"我的购物车里，薯片和可乐旁边，总得放点牛奶和麦片才安心。\", \"dim\": \"必需品纯度\"}, {\"title\": \"逛超市时，我的快乐源泉是往车里扔各种新出的零食。\", \"dim\": \"享乐品密度\"}, {\"title\": \"看到包装好看的饮料，就算不知道味道，我也会拿一瓶试试。\", \"dim\": \"享乐品密度\"}, {\"title\": \"结账时发现超预算，我第一个想放回去的，永远是那些“没用但快乐”的东西。\", \"dim\": \"享乐品密度\"}, {\"title\": \"在货架前，我会因为“买A还是买B”纠结超过一分钟。\", \"dim\": \"决策犹豫度\"}, {\"title\": \"把东西放进购物车后，我又会拿出来放回货架，这种事我常干。\", \"dim\": \"决策犹豫度\"}, {\"title\": \"我经常因为想不好买哪个口味，最后干脆什么都不买。\", \"dim\": \"决策犹豫度\"}, {\"title\": \"我逛超市的路线，通常是“入口→生鲜→粮油→零食→收银”，很少乱走。\", \"dim\": \"路径规划性\"}, {\"title\": \"我会为了买一瓶酱油，特意跑一趟超市，不买别的。\", \"dim\": \"路径规划性\"}, {\"title\": \"如果超市重新摆了货架，我会觉得有点烦躁。\", \"dim\": \"路径规划性\"}, {\"title\": \"我试过推着空车在超市里逛，什么也不买，就看看。\", \"dim\": \"空转哲学值\"}, {\"title\": \"有时候逛超市，不是为了买东西，就是为了感受那种“生活气息”。\", \"dim\": \"空转哲学值\"}, {\"title\": \"我觉得，在超市里漫无目的地闲逛，本身也是一种放松。\", \"dim\": \"空转哲学值\"}], \"resultTypes\": [{\"name\": \"苦行僧\", \"emoji\": \"🧘\", \"emojiBg\": \"#E0E0E0\", \"desc\": \"你的购物车像一份精准的采购单，目标明确，绝无冗余。人生轨迹清晰笔直，但偶尔会不会觉得，少了点计划外的惊喜？\", \"match\": \"必需品纯度\"}, {\"name\": \"享乐派\", \"emoji\": \"🎉\", \"emojiBg\": \"#FF9F43\", \"desc\": \"你的购物车是快乐的试验田，塞满了“想要”而非“需要”。人生轨迹充满即兴的甜头，但月底看着账单时，快乐会打折吗？\", \"match\": \"享乐品密度\"}, {\"name\": \"选择困难症晚期\", \"emoji\": \"🤯\", \"emojiBg\": \"#6C5CE7\", \"desc\": \"你的购物车是内心戏的舞台，每一个选项都意味着一次灵魂拷问。人生轨迹充满了岔路口和折返跑，但或许，犹豫本身就是你的路标。\", \"match\": \"决策犹豫度\"}, {\"name\": \"路径依赖者\", \"emoji\": \"🗺️\", \"emojiBg\": \"#00B894\", \"desc\": \"你的购物车遵循着最优算法，效率至上，讨厌意外。人生轨迹像一张执行良好的日程表，稳定，但可能也错过了隔壁通道的特价草莓。\", \"match\": \"路径规划性\"}, {\"name\": \"超市哲学家\", \"emoji\": \"🤔\", \"emojiBg\": \"#74B9FF\", \"desc\": \"你的购物车常常是空的，但你的大脑是满的。你的人生轨迹不在于买了什么，而在于“观看”和“思考”这个过程本身。推着空车逛三圈，世界就是你的。\", \"match\": \"空转哲学值\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"你的暗恋进度像什么下载任务\", \"title\": \"你的暗恋，卡在百分之几？\", \"dims\": [\"下载启动速度\", \"进度条卡点\", \"后台运行强度\", \"断点续传能力\", \"资源占用率\", \"最终处理方式\"], \"qs\": [{\"title\": \"我意识到自己喜欢上TA，几乎是一瞬间的事。\", \"dim\": \"下载启动速度\"}, {\"title\": \"从注意到TA到决定“喜欢”，中间没怎么犹豫。\", \"dim\": \"下载启动速度\"}, {\"title\": \"别人还在试探，我已经火速把TA的社交动态翻了个底朝天。\", \"dim\": \"下载启动速度\"}, {\"title\": \"我和TA的关系，好像永远停留在“点赞之交”或“偶尔聊天”这一步。\", \"dim\": \"进度条卡点\"}, {\"title\": \"每次想往前推进一点，就会遇到各种“意外”卡住，比如TA突然忙了，或者话题断了。\", \"dim\": \"进度条卡点\"}, {\"title\": \"最亲密的互动，可能也就是帮TA抢过一张演唱会门票，然后……就没有然后了。\", \"dim\": \"进度条卡点\"}, {\"title\": \"即使一整天没说话，我也会时不时想起TA。\", \"dim\": \"后台运行强度\"}, {\"title\": \"刷到好玩的视频或段子，第一个想分享的人永远是TA。\", \"dim\": \"后台运行强度\"}, {\"title\": \"我会在共同朋友的聊天里，格外留意有没有提到TA的名字。\", \"dim\": \"后台运行强度\"}, {\"title\": \"如果冷了一段时间，再看到TA发动态，那种喜欢的感觉又会“噌”一下回来。\", \"dim\": \"断点续传能力\"}, {\"title\": \"我试过放下，但总因为一些小事（比如TA换了新头像）又重燃希望。\", \"dim\": \"断点续传能力\"}, {\"title\": \"哪怕TA有了新恋情传闻，等风波过去，我可能还是会偷偷关注TA。\", \"dim\": \"断点续传能力\"}, {\"title\": \"为了揣摩TA一句话的意思，我能耗掉半小时。\", \"dim\": \"资源占用率\"}, {\"title\": \"TA的社交账号是我手机浏览器的常驻标签页之一。\", \"dim\": \"资源占用率\"}, {\"title\": \"我会因为TA没回消息，而影响自己接下来做事的效率。\", \"dim\": \"资源占用率\"}, {\"title\": \"我清楚地知道，继续下去可能也没结果，但就是舍不得彻底关掉这个页面。\", \"dim\": \"最终处理方式\"}, {\"title\": \"我设想过无数次“要不就算了”的场景，但最终都没执行。\", \"dim\": \"最终处理方式\"}, {\"title\": \"这份暗恋像电脑角落一个积灰的文件夹，不常打开，但也从未删除。\", \"dim\": \"最终处理方式\"}], \"resultTypes\": [{\"name\": \"秒速启动型\", \"emoji\": \"⚡\", \"emojiBg\": \"#FFD93D\", \"desc\": \"你的喜欢来得又快又猛，像点了“立即下载”就瞬间冲到99%，然后……就卡住了。热情是满格的，进度是停滞的。\", \"match\": \"下载启动速度\"}, {\"name\": \"永恒99%\", \"emoji\": \"⏳\", \"emojiBg\": \"#C9C9C9\", \"desc\": \"你的暗恋永远差那临门一脚。关系维持在一种微妙的、无法前进的平衡里，像那个永远下载不完的文件，看得见，摸不着。\", \"match\": \"进度条卡点\"}, {\"name\": \"后台常驻进程\", \"emoji\": \"🔄\", \"emojiBg\": \"#6BCEF7\", \"desc\": \"你的喜欢从不喧宾夺主，但永远在后台安静运行，消耗着你的内存（精力）。你正常生活，但总有一个线程在惦记TA。\", \"match\": \"后台运行强度\"}, {\"name\": \"顽强续传者\", \"emoji\": \"📥\", \"emojiBg\": \"#A8EA8A\", \"desc\": \"你的暗恋生命力极强，冷了一段时间，稍有风吹草动（TA发动态了）就能自动续传。放下？不存在的，顶多是暂停。\", \"match\": \"断点续传能力\"}, {\"name\": \"高占用进程\", \"emoji\": \"🔥\", \"emojiBg\": \"#FF9F43\", \"desc\": \"你的暗恋是个“电老虎”，大量占用你的情绪和注意力资源。你一边吐槽自己恋爱脑，一边忍不住去分析TA的每一个标点符号。\", \"match\": \"资源占用率\"}, {\"name\": \"未完成项目\", \"emoji\": \"🗂️\", \"emojiBg\": \"#B5B5B5\", \"desc\": \"你的暗恋像一个被搁置的“未完成项目”。你不会主动推进，但也绝不点击“取消”。它就躺在那里，占着一个位置，也占着一份念想。\", \"match\": \"最终处理方式\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"前世是什么部门什么角色\", \"title\": \"你上辈子在哪个衙门当差？\", \"dims\": [\"摸鱼划水熟练度\", \"职场生存伪装术\", \"责任规避雷达\", \"能量补给依赖度\", \"工位生态位\"], \"qs\": [{\"title\": \"我能在领导眼皮底下，用最小窗口刷完一整集剧。\", \"dim\": \"摸鱼划水熟练度\"}, {\"title\": \"我的工作节奏是：领导来前装忙，领导走后真忙（自己的事）。\", \"dim\": \"摸鱼划水熟练度\"}, {\"title\": \"我熟练掌握Alt+Tab切换工作界面的肌肉记忆。\", \"dim\": \"摸鱼划水熟练度\"}, {\"title\": \"我的电脑桌面永远开着至少三个看起来像正经工作的窗口。\", \"dim\": \"职场生存伪装术\"}, {\"title\": \"开会时我表情严肃点头，其实脑子里在规划晚上吃什么。\", \"dim\": \"职场生存伪装术\"}, {\"title\": \"我能把五分钟能做完的事，拖出“正在全力推进”的仪式感。\", \"dim\": \"职场生存伪装术\"}, {\"title\": \"闻到锅味（指背锅），我的第一反应是“这不在我职责范围内”。\", \"dim\": \"责任规避雷达\"}, {\"title\": \"看到“@所有人”和“收到请回复”，我会等至少三个人回复后再动。\", \"dim\": \"责任规避雷达\"}, {\"title\": \"遇到模糊地带的工作，我的本能是把它推给“更合适”的同事。\", \"dim\": \"责任规避雷达\"}, {\"title\": \"下午三点是我的固定能量低谷，必须靠奶茶/咖啡续命。\", \"dim\": \"能量补给依赖度\"}, {\"title\": \"我的办公桌抽屉里，常备着能顶一顿饭的零食库存。\", \"dim\": \"能量补给依赖度\"}, {\"title\": \"我觉得带薪拉屎是打工人不可剥夺的基本权益与重要回血方式。\", \"dim\": \"能量补给依赖度\"}, {\"title\": \"我的工位布置得像个小堡垒，有毯子、枕头和眼罩。\", \"dim\": \"工位生态位\"}, {\"title\": \"我精准掌握了办公室每个监控死角和领导巡查的路线时间。\", \"dim\": \"工位生态位\"}, {\"title\": \"我在同事中的人设是“看起来挺忙但不知道在忙啥”的那种。\", \"dim\": \"工位生态位\"}], \"resultTypes\": [{\"name\": \"御膳房偷吃太监\", \"emoji\": \"🍗\", \"emojiBg\": \"#FF9F43\", \"desc\": \"摸鱼界的宗师。深谙“偷吃”与“装忙”的平衡之道，总能精准地在不被发现的情况下，把属于自己的那份“福利”吃到嘴里。表面恭敬，实则摸得一手好鱼。\", \"match\": \"摸鱼划水熟练度\"}, {\"name\": \"御前行走（装忙版）\", \"emoji\": \"👑\", \"emojiBg\": \"#F0D9A8\", \"desc\": \"职场影帝/影后。永远在领导视线内保持“积极忙碌”状态，演技精湛，滴水不漏。是“假装努力”领域的标杆人物，深得“形式主义”精髓。\", \"match\": \"职场生存伪装术\"}, {\"name\": \"宗人府甩锅高手\", \"emoji\": \"🛡️\", \"emojiBg\": \"#C9C9C9\", \"desc\": \"风险规避大师。拥有敏锐的“背锅雷达”，总能提前嗅到麻烦并优雅闪避。擅长厘清（或模糊）责任边界，确保自己永远站在安全区。\", \"match\": \"责任规避雷达\"}, {\"name\": \"光禄寺零食采办\", \"emoji\": \"🍱\", \"emojiBg\": \"#6BCF7F\", \"desc\": \"能量补给核心成员。深刻理解“民以食为天”，工位就是你的补给站。靠奶茶续命，靠零食回血，认为吃饱喝足才是高效（摸鱼）工作的第一生产力。\", \"match\": \"能量补给依赖度\"}, {\"name\": \"冷宫常驻编外人员\", \"emoji\": \"🏮\", \"emojiBg\": \"#A8D8EA\", \"desc\": \"存在感管理大师。成功将自己置于一个“不被重视但也不被开除”的完美生态位。工位是你的王国，你在此安居乐业，与世无争，默默经营着自己的小日子。\", \"match\": \"工位生态位\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"人生加载进度条\", \"title\": \"你的进度条，卡在哪儿了？\", \"dims\": [\"启动延迟\", \"后台进程数\", \"卡顿频率\", \"进度条样式\", \"强制重启阈值\"], \"qs\": [{\"title\": \"闹钟响了，我能在床上再躺半小时，就是不起。\", \"dim\": \"启动延迟\"}, {\"title\": \"说好今天开始学新技能，结果先刷了三小时手机。\", \"dim\": \"启动延迟\"}, {\"title\": \"周末计划出门，光是“出门前准备”就能耗掉一上午。\", \"dim\": \"启动延迟\"}, {\"title\": \"我脑子里同时想着工作、晚饭吃什么、以及三年前某件尴尬事。\", \"dim\": \"后台进程数\"}, {\"title\": \"手机后台永远有十几个APP没关，电脑也是。\", \"dim\": \"后台进程数\"}, {\"title\": \"一边看剧，一边回消息，一边还想明天穿什么。\", \"dim\": \"后台进程数\"}, {\"title\": \"写东西写到一半，突然开始整理桌面。\", \"dim\": \"卡顿频率\"}, {\"title\": \"跟人聊天，经常“呃……那个词叫什么来着”。\", \"dim\": \"卡顿频率\"}, {\"title\": \"走到房间门口，突然忘了进来要拿什么。\", \"dim\": \"卡顿频率\"}, {\"title\": \"我的计划表，永远停留在“新建文档”这一步。\", \"dim\": \"进度条样式\"}, {\"title\": \"我更喜欢那种有百分比数字的进度条，哪怕它不动。\", \"dim\": \"进度条样式\"}, {\"title\": \"事情做一半，我会忍不住去刷新页面，看有没有“进度”。\", \"dim\": \"进度条样式\"}, {\"title\": \"连续加班三天后，我会直接关机睡一整天。\", \"dim\": \"强制重启阈值\"}, {\"title\": \"如果一件事反复出错还解决不了，我会扔下不管，过几天再说。\", \"dim\": \"强制重启阈值\"}, {\"title\": \"情绪崩到顶点时，我的处理方式是消失，谁的消息都不回。\", \"dim\": \"强制重启阈值\"}], \"resultTypes\": [{\"name\": \"开机自检型\", \"emoji\": \"⏳\", \"emojiBg\": \"#B8B8B8\", \"desc\": \"启动流程极其漫长，但一旦动起来就还算稳定。你的每一天都是从漫长的“心理建设”开始的。\", \"match\": \"启动延迟\"}, {\"name\": \"多线程过载\", \"emoji\": \"💻\", \"emojiBg\": \"#6C5CE7\", \"desc\": \"后台塞满了未完成的想法和待办事项，CPU常年高温报警。你看起来在休息，脑子可能比上班还忙。\", \"match\": \"后台进程数\"}, {\"name\": \"间歇性卡顿\", \"emoji\": \"🌀\", \"emojiBg\": \"#00CEC9\", \"desc\": \"运行不算慢，但总在奇怪的地方突然转圈圈。话到嘴边忘了，事到眼前懵了，是你的日常体验。\", \"match\": \"卡顿频率\"}, {\"name\": \"虚假进度条爱好者\", \"emoji\": \"📊\", \"emojiBg\": \"#FDCB6E\", \"desc\": \"你沉迷于制造“正在加载”的幻觉。列表打了无数勾，但核心任务进度可能还是0%。形式大于内容是你的保护色。\", \"match\": \"进度条样式\"}, {\"name\": \"强制重启型\", \"emoji\": \"🔁\", \"emojiBg\": \"#FF7675\", \"desc\": \"忍耐力有个明确的红线，一旦触及，不管进度到99%还是1%，都会直接黑屏重启。你的崩溃是彻底而决绝的。\", \"match\": \"强制重启阈值\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"你的拖延症是什么形态\", \"title\": \"你的拖延，是哪种拖延？\", \"dims\": [\"爆发前夜指数\", \"明日复明日循环\", \"启动阻力系数\", \"完美主义卡点\", \"环境依赖度\", \"自我欺骗熟练度\"], \"qs\": [{\"title\": \"我经常在截止日期前夜，才爆发出惊人的生产力。\", \"dim\": \"爆发前夜指数\"}, {\"title\": \"不到最后一刻，我总觉得还有时间。\", \"dim\": \"爆发前夜指数\"}, {\"title\": \"压力越大，我反而越能集中精神把事情做完。\", \"dim\": \"爆发前夜指数\"}, {\"title\": \"“明天再说”是我最常对自己说的话之一。\", \"dim\": \"明日复明日循环\"}, {\"title\": \"我列过很多次“从下周一开始”的计划，但很少真的开始。\", \"dim\": \"明日复明日循环\"}, {\"title\": \"一件事拖久了，我会觉得“反正都拖这么久了，再拖一天也没差”。\", \"dim\": \"明日复明日循环\"}, {\"title\": \"打开文档/软件，对着空白页发呆半小时，是我开始工作的常态。\", \"dim\": \"启动阻力系数\"}, {\"title\": \"一想到要开始做那件麻烦事，我就想先刷会儿手机。\", \"dim\": \"启动阻力系数\"}, {\"title\": \"我经常用“我得先准备一下”来合理化自己迟迟不开始。\", \"dim\": \"启动阻力系数\"}, {\"title\": \"我总想把开头/第一版做得尽善尽美，结果反而迟迟无法推进。\", \"dim\": \"完美主义卡点\"}, {\"title\": \"因为害怕做得不够好，我宁愿选择不做。\", \"dim\": \"完美主义卡点\"}, {\"title\": \"我会反复修改已经完成的部分，而不是继续往下做。\", \"dim\": \"完美主义卡点\"}, {\"title\": \"我的工作效率极度依赖“对的环境”，比如特定的桌子、时间或氛围。\", \"dim\": \"环境依赖度\"}, {\"title\": \"只要周围有一点干扰（比如有人说话），我就很难专注做事。\", \"dim\": \"环境依赖度\"}, {\"title\": \"我总觉得“等我有整块时间/等周末/等放假”就能好好做事。\", \"dim\": \"环境依赖度\"}, {\"title\": \"我会把刷社交媒体、整理房间这些事，美化成“必要的准备工作”。\", \"dim\": \"自我欺骗熟练度\"}, {\"title\": \"我经常告诉自己“我在思考”，其实只是在发呆或焦虑。\", \"dim\": \"自我欺骗熟练度\"}, {\"title\": \"拖延到最后，我会用“至少我完成了”来安慰自己，忽略过程中的煎熬。\", \"dim\": \"自我欺骗熟练度\"}], \"resultTypes\": [{\"name\": \"死线战士\", \"emoji\": \"⚡\", \"emojiBg\": \"#FF9F43\", \"desc\": \"你的拖延是精准的定时炸弹。平时风平浪静，甚至有点躺平，但一旦进入倒计时，就会化身效率怪物，在爆炸前夜完成一切。肾上腺素是你的最佳燃料。\", \"match\": \"爆发前夜指数\"}, {\"name\": \"明日循环体\", \"emoji\": \"🔄\", \"emojiBg\": \"#A8D8EA\", \"desc\": \"你的拖延是一场没有尽头的“明天见”。每一个“明天”都承载着希望，但太阳照常升起，计划照常推迟。你活在永恒的“准备开始”状态里。\", \"match\": \"明日复明日循环\"}, {\"name\": \"启动困难户\", \"emoji\": \"🪨\", \"emojiBg\": \"#C9C9C9\", \"desc\": \"对你来说，最难的不是过程，是开始。仿佛有看不见的阻力场包裹着任务，光是想到要启动，就耗尽了所有心力。你的能量大多用在和“开始”搏斗上。\", \"match\": \"启动阻力系数\"}, {\"name\": \"完美主义绊脚石\", \"emoji\": \"💎\", \"emojiBg\": \"#FFD93D\", \"desc\": \"你被自己设定的高标准困住了。因为害怕不完美、害怕瑕疵，你宁愿让任务停留在“未完成但可能完美”的想象中，也不愿接受一个“完成了但普通”的现实。\", \"match\": \"完美主义卡点\"}, {\"name\": \"环境豌豆公主\", \"emoji\": \"👑\", \"emojiBg\": \"#F0D9A8\", \"desc\": \"你的生产力极度娇贵，需要天时地利人和。不对的灯光、不对的噪音、不对的心情，都能成为你合理拖延的理由。你在等待一个永远不会完全到位的“完美条件”。\", \"match\": \"环境依赖度\"}, {\"name\": \"自我催眠大师\", \"emoji\": \"🎭\", \"emojiBg\": \"#6BCF7F\", \"desc\": \"你拥有将拖延合理化的顶级话术。刷手机是在“搜集灵感”，发呆是在“深度思考”，焦虑是在“酝酿情绪”。你甚至能说服自己，拖延是一种更高级的工作策略。\", \"match\": \"自我欺骗熟练度\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"周末失忆症\", \"title\": \"你的周末记忆还在吗？\", \"dims\": [\"计划雄心指数\", \"启动能量槽\", \"执行偏差率\", \"记忆蒸发速度\", \"周日悔恨值\"], \"qs\": [{\"title\": \"周五晚上，我脑子里至少有三个待办事项在闪闪发光。\", \"dim\": \"计划雄心指数\"}, {\"title\": \"我觉得周末就应该用来学点新东西、见见朋友、整理房间。\", \"dim\": \"计划雄心指数\"}, {\"title\": \"我经常在周五深夜刷到某个教程或活动，立刻决定“这周末就干这个”。\", \"dim\": \"计划雄心指数\"}, {\"title\": \"周六早上醒来，第一个念头是“再躺五分钟”。\", \"dim\": \"启动能量槽\"}, {\"title\": \"起床后，光是决定先刷牙还是先看手机，就能耗掉我半小时。\", \"dim\": \"启动能量槽\"}, {\"title\": \"我经常把“下午再说”挂在嘴边，然后下午就没了。\", \"dim\": \"启动能量槽\"}, {\"title\": \"我计划去咖啡馆学习，结果带去的书一页没翻，刷了三小时短视频。\", \"dim\": \"执行偏差率\"}, {\"title\": \"说好周末只吃健康餐，结果外卖软件自己跳到了炸鸡页面。\", \"dim\": \"执行偏差率\"}, {\"title\": \"我整理房间，通常以“找到一本旧书/一件旧衣服然后开始回忆”告终，房间更乱了。\", \"dim\": \"执行偏差率\"}, {\"title\": \"周日晚上朋友问我周末干了啥，我大脑一片空白。\", \"dim\": \"记忆蒸发速度\"}, {\"title\": \"我完全不记得周六下午具体是怎么过的，只记得好像一直在沙发上。\", \"dim\": \"记忆蒸发速度\"}, {\"title\": \"翻看手机相册，发现周末一张照片都没拍，因为根本没出门。\", \"dim\": \"记忆蒸发速度\"}, {\"title\": \"周日晚上躺在床上，我会开始焦虑周一。\", \"dim\": \"周日悔恨值\"}, {\"title\": \"我经常在周日深夜发誓“下周末一定不一样”。\", \"dim\": \"周日悔恨值\"}, {\"title\": \"我觉得周末两天像被谁偷走了一样，什么也没留下。\", \"dim\": \"周日悔恨值\"}], \"resultTypes\": [{\"name\": \"蓝图大师\", \"emoji\": \"🗺️\", \"emojiBg\": \"#4A90E2\", \"desc\": \"你的计划表能写满一张A4纸，从早到晚安排得明明白白。虽然执行是另一回事，但光是制定计划的过程，就让你感觉周末已经充实了一半。\", \"match\": \"计划雄心指数\"}, {\"name\": \"起床困难户\", \"emoji\": \"🛌\", \"emojiBg\": \"#FF9F43\", \"desc\": \"你的周末从中午开始。床、沙发、地毯，任何能瘫着的地方都是你的主场。启动一项计划所需的能量，比你想象中要多得多。\", \"match\": \"启动能量槽\"}, {\"name\": \"计划刺客\", \"emoji\": \"🎯\", \"emojiBg\": \"#FF6B6B\", \"desc\": \"你擅长用一百种意想不到的方式，完美避开自己制定的所有计划。去健身变成买奶茶，看书变成刷剧，你的周末总在计划外的地方精彩着。\", \"match\": \"执行偏差率\"}, {\"name\": \"记忆金鱼\", \"emoji\": \"🐠\", \"emojiBg\": \"#A8D8EA\", \"desc\": \"你的周末记忆只有七秒。周日晚上的你，已经想不起周六午饭吃了什么。周末对你来说不是一个连续的时间段，而是几个模糊的、瘫着的瞬间。\", \"match\": \"记忆蒸发速度\"}, {\"name\": \"周日emo怪\", \"emoji\": \"😔\", \"emojiBg\": \"#6C5CE7\", \"desc\": \"周日傍晚，一种熟悉的空虚和焦虑准时降临。你开始复盘这个“又浪费了”的周末，并陷入“为什么我总这样”的哲学思考，直到周一闹钟响起。\", \"match\": \"周日悔恨值\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"前世加班猝死鉴定\", \"title\": \"你这辈子这么怕加班，是不是上辈子有阴影？\", \"dims\": [\"加班PTSD闪回频率\", \"职场耗材感知度\", \"生理性下班反应\", \"工位创伤应激源\", \"转世记忆残留度\", \"灵魂过劳警戒线\"], \"qs\": [{\"title\": \"看到“收到请回复”几个字，心脏会下意识一紧。\", \"dim\": \"加班PTSD闪回频率\"}, {\"title\": \"听到钉钉/微信工作群的消息提示音，会瞬间进入战斗或逃跑状态。\", \"dim\": \"加班PTSD闪回频率\"}, {\"title\": \"梦里出现过在工位改PPT，醒来发现枕头湿了（汗或泪）。\", \"dim\": \"加班PTSD闪回频率\"}, {\"title\": \"我觉得自己就是公司这台机器里一颗可替换的螺丝钉。\", \"dim\": \"职场耗材感知度\"}, {\"title\": \"看到“年轻人要多锻炼”的鸡汤，第一反应是“为了能多扛几年班”。\", \"dim\": \"职场耗材感知度\"}, {\"title\": \"体检报告上的异常项，在我眼里是“工龄磨损证明”。\", \"dim\": \"职场耗材感知度\"}, {\"title\": \"一到下班点，身体会自动进入“电量耗尽”模式，多待一秒都头晕。\", \"dim\": \"生理性下班反应\"}, {\"title\": \"如果被迫加班，我的肠胃会先于我的意识开始抗议（比如突然胃痛）。\", \"dim\": \"生理性下班反应\"}, {\"title\": \"周末晚上想到明天要上班，会真实地感到胸闷气短。\", \"dim\": \"生理性下班反应\"}, {\"title\": \"我对办公室的日光灯和中央空调出风口的声音有生理性厌恶。\", \"dim\": \"工位创伤应激源\"}, {\"title\": \"闻到外卖的廉价塑料盒味道，会联想到无数个加班的晚餐。\", \"dim\": \"工位创伤应激源\"}, {\"title\": \"看到“奋斗”“拼搏”这类词出现在公司墙上，会下意识翻白眼。\", \"dim\": \"工位创伤应激源\"}, {\"title\": \"我对“福报”“兄弟”这些词有超越常人的警惕和反感。\", \"dim\": \"转世记忆残留度\"}, {\"title\": \"有时候会觉得，自己这么熟练的摸鱼技巧，不像这辈子刚学的。\", \"dim\": \"转世记忆残留度\"}, {\"title\": \"看到新闻里某某大厂员工猝死，会有一种“差点就是我”的共情与后怕。\", \"dim\": \"转世记忆残留度\"}, {\"title\": \"我给自己设了一条绝对红线：连续加班绝不超过X天（X≤3）。\", \"dim\": \"灵魂过劳警戒线\"}, {\"title\": \"如果感觉心脏不舒服，我会立刻停下工作，不管项目多急。\", \"dim\": \"灵魂过劳警戒线\"}, {\"title\": \"我坚信“工资是买我8小时的，不是买我命的”。\", \"dim\": \"灵魂过劳警戒线\"}], \"resultTypes\": [{\"name\": \"间歇性闪回型\", \"emoji\": \"👻\", \"emojiBg\": \"#B19CD9\", \"desc\": \"平时还好，但特定触发点（如深夜消息、特定词汇）会让你瞬间梦回上辈子的工位。灵魂深处有未愈合的加班伤疤，一碰就疼。\", \"match\": \"加班PTSD闪回频率\"}, {\"name\": \"清醒的耗材\", \"emoji\": \"⚙️\", \"emojiBg\": \"#A9A9A9\", \"desc\": \"你对自己“职场燃料”的定位有着冰冷而清晰的认知。不抱幻想，只计算性价比，在耗尽前尽可能为自己谋划退路。\", \"match\": \"职场耗材感知度\"}, {\"name\": \"到点宕机体质\", \"emoji\": \"🪫\", \"emojiBg\": \"#FF9F43\", \"desc\": \"你的身体比你的闹钟更准时。下班时间一到，所有生理系统同步进入节能模式，多干一分钟都是对生命系统的背叛。\", \"match\": \"生理性下班反应\"}, {\"name\": \"工位创伤后遗症\", \"emoji\": \"💡\", \"emojiBg\": \"#F0F0F0\", \"desc\": \"你对工位环境有着近乎过敏的反应。灯光、气味、声音……这些上辈子折磨你的元素，这辈子成了你的应激源。\", \"match\": \"工位创伤应激源\"}, {\"name\": \"孟婆汤掺水版\", \"emoji\": \"🍵\", \"emojiBg\": \"#D4E6F1\", \"desc\": \"孟婆汤可能过期了，你带着模糊但深刻的“前世记忆”而来。对加班文化的本能抗拒，是你灵魂自带的防猝死补丁。\", \"match\": \"转世记忆残留度\"}, {\"name\": \"红线守卫者\", \"emoji\": \"🚧\", \"emojiBg\": \"#FF6B6B\", \"desc\": \"你为自己设立了明确的、不可逾越的过劳警戒线。这不是懒惰，是上辈子用命换来的生存智慧，这辈子绝不再越雷池一步。\", \"match\": \"灵魂过劳警戒线\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"用奶茶配料看性格\", \"title\": \"你的奶茶配方，暴露了你什么？\", \"dims\": [\"甜度选择倾向\", \"加料丰富度\", \"冰度控制欲\", \"配料分离度\", \"配方稳定性\"], \"qs\": [{\"title\": \"我点奶茶，默认选项就是全糖。\", \"dim\": \"甜度选择倾向\"}, {\"title\": \"生活已经够苦了，饮料必须得是甜的。\", \"dim\": \"甜度选择倾向\"}, {\"title\": \"看到别人点无糖，我会觉得他在喝一种很新的中药。\", \"dim\": \"甜度选择倾向\"}, {\"title\": \"我的奶茶里必须加至少两种小料，不然感觉钱白花了。\", \"dim\": \"加料丰富度\"}, {\"title\": \"点单时，我会把能加的都勾上，主打一个料比茶多。\", \"dim\": \"加料丰富度\"}, {\"title\": \"喝奶茶的乐趣，一半在嚼。\", \"dim\": \"加料丰富度\"}, {\"title\": \"我喝奶茶一定要去冰，常温都觉得不够精确。\", \"dim\": \"冰度控制欲\"}, {\"title\": \"冰化掉会稀释味道，这是我不能容忍的。\", \"dim\": \"冰度控制欲\"}, {\"title\": \"我对温度很敏感，多一度少一度都能喝出来。\", \"dim\": \"冰度控制欲\"}, {\"title\": \"如果点了珍珠奶茶，我会要求珍珠单独放。\", \"dim\": \"配料分离度\"}, {\"title\": \"我不喜欢小料泡软了的口感，必须按我的节奏加入。\", \"dim\": \"配料分离度\"}, {\"title\": \"我觉得奶茶是奶茶，料是料，混在一起是对两者的不尊重。\", \"dim\": \"配料分离度\"}, {\"title\": \"我有一款喝了十年的招牌配方，雷打不动。\", \"dim\": \"配方稳定性\"}, {\"title\": \"尝试新品对我来说是种冒险，大概率会踩雷。\", \"dim\": \"配方稳定性\"}, {\"title\": \"店员要是记错了我的配方，我能郁闷一整天。\", \"dim\": \"配方稳定性\"}], \"resultTypes\": [{\"name\": \"全糖战士\", \"emoji\": \"🍬\", \"emojiBg\": \"#FF9F43\", \"desc\": \"你的生活哲学是及时行乐，拒绝苦味。甜度是你的安全感来源，一点苦涩都让你皱眉。人生信条：先甜了再说。\", \"match\": \"甜度选择倾向\"}, {\"name\": \"八宝粥型\", \"emoji\": \"🥣\", \"emojiBg\": \"#6BCF7F\", \"desc\": \"你信奉“多多益善”，热爱堆砌的满足感。对你而言，空杯是种罪恶，满杯才是正义。生活也要像这杯奶茶一样，料足，扎实。\", \"match\": \"加料丰富度\"}, {\"name\": \"温度控制狂\", \"emoji\": \"🌡️\", \"emojiBg\": \"#A8D8EA\", \"desc\": \"你对秩序和精确有近乎偏执的追求。冰度只是表象，背后是你对生活中一切“变量”的严格管控。一切必须在计划内，包括奶茶的温度。\", \"match\": \"冰度控制欲\"}, {\"name\": \"分装大师\", \"emoji\": \"🧪\", \"emojiBg\": \"#C9C9C9\", \"desc\": \"边界感是你的生命线。你喜欢一切事物都条理清晰，各归其位。混乱对你来说是种折磨，你必须亲手掌控所有元素的混合时机与比例。\", \"match\": \"配料分离度\"}, {\"name\": \"经典复刻派\", \"emoji\": \"🔄\", \"emojiBg\": \"#F0D9A8\", \"desc\": \"你依赖熟悉感带来的安全与舒适。改变对你而言成本很高，你宁愿在已知的完美配方里获得100次满足，也不愿冒险尝试99次可能的失望。\", \"match\": \"配方稳定性\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"出门前的准备时长\", \"title\": \"你的“马上出门”是多久？\", \"dims\": [\"启动延迟\", \"流程复杂度\", \"记忆断片率\", \"意外插曲频次\", \"出门前电量焦虑\"], \"qs\": [{\"title\": \"朋友说“下楼了”，我还在纠结穿哪双袜子。\", \"dim\": \"启动延迟\"}, {\"title\": \"“马上出门”这句话从我嘴里说出来，基本等于“我还没换鞋”。\", \"dim\": \"启动延迟\"}, {\"title\": \"约好时间前半小时，我总觉得还早，可以再刷五分钟手机。\", \"dim\": \"启动延迟\"}, {\"title\": \"我的出门流程包括但不限于：找钥匙、换鞋、突然想上厕所、检查煤气、再照一次镜子。\", \"dim\": \"流程复杂度\"}, {\"title\": \"出门前我有个固定动线：卧室→客厅→厨房→卫生间→再回卧室拿忘带的东西。\", \"dim\": \"流程复杂度\"}, {\"title\": \"我觉得“拿上包就走”是一种都市传说。\", \"dim\": \"流程复杂度\"}, {\"title\": \"钥匙明明一分钟前还在手里，换完鞋就不知道放哪了。\", \"dim\": \"记忆断片率\"}, {\"title\": \"走到楼下才想起来，好像没锁门/没关灯/没带手机。\", \"dim\": \"记忆断片率\"}, {\"title\": \"出门前最后一刻，总会突然怀疑自己忘了某件重要的事，但想不起来是什么。\", \"dim\": \"记忆断片率\"}, {\"title\": \"每次临出门，不是快递来了就是突然想拉屎。\", \"dim\": \"意外插曲频次\"}, {\"title\": \"换好衣服准备走，发现衣服上有根猫毛/油点，又得回去换。\", \"dim\": \"意外插曲频次\"}, {\"title\": \"“马上好”之后，通常还会接一个“等一下，我……”的转折。\", \"dim\": \"意外插曲频次\"}, {\"title\": \"手机电量低于80%，我出门就会焦虑。\", \"dim\": \"出门前电量焦虑\"}, {\"title\": \"哪怕只是下楼取快递，我也得把充电宝带上才安心。\", \"dim\": \"出门前电量焦虑\"}, {\"title\": \"我会因为手机快没电了，而推迟或取消出门计划。\", \"dim\": \"出门前电量焦虑\"}], \"resultTypes\": [{\"name\": \"蓄力型选手\", \"emoji\": \"🐢\", \"emojiBg\": \"#A8D8EA\", \"desc\": \"你的“马上”是一个需要漫长预热的过程。从接收到出门指令到身体真正动起来，中间隔着一条名为“拖延”的鸿沟。朋友已经到楼下了，你的灵魂可能还在床上。\", \"match\": \"启动延迟\"}, {\"name\": \"仪式感大师\", \"emoji\": \"🎭\", \"emojiBg\": \"#FF9F43\", \"desc\": \"出门对你而言不是动作，是一套完整的仪式。每个环节都有其神圣不可侵犯的顺序和意义。简化流程？那出门的乐趣和安全感就少了一半。\", \"match\": \"流程复杂度\"}, {\"name\": \"金鱼记忆体\", \"emoji\": \"🐠\", \"emojiBg\": \"#6BC5D2\", \"desc\": \"你的记忆在出门这个动作面前会选择性清零。钥匙、手机、口罩……它们总在最后一刻玩起捉迷藏。你的出门时长，一半花在准备，一半花在寻找。\", \"match\": \"记忆断片率\"}, {\"name\": \"插曲吸引体质\", \"emoji\": \"🎪\", \"emojiBg\": \"#FFD93D\", \"desc\": \"你的出门之路注定不会平坦。总有各种意想不到的小事精准地卡在“即将踏出家门”的瞬间发生。你不是在出门，你是在为一场即兴生活情景剧担任主演。\", \"match\": \"意外插曲频次\"}, {\"name\": \"电量恐慌症晚期\", \"emoji\": \"🔋\", \"emojiBg\": \"#C9C9C9\", \"desc\": \"对你来说，手机电量不是数字，是安全感指数。电量不满，出门就像裸奔。你的“马上出门”很可能包含“等我充到100%”这个隐藏步骤。\", \"match\": \"出门前电量焦虑\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"办公室神秘失踪事件2.0\", \"title\": \"你的工作热情，失踪到哪一步了？\", \"dims\": [\"心情失踪速度\", \"希望蒸发阈值\", \"摸鱼伪装等级\", \"重启失败率\", \"未来视野清晰度\", \"工位结界强度\"], \"qs\": [{\"title\": \"周一早上打开电脑，我的大脑需要至少半小时才能从“我是谁我在哪”切换到工作模式。\", \"dim\": \"心情失踪速度\"}, {\"title\": \"被拉进一个无关紧要的会，我的工作热情会以肉眼可见的速度从体内抽离。\", \"dim\": \"心情失踪速度\"}, {\"title\": \"下午三点收到一条新需求，我第一反应不是“怎么做”，而是“又来了”。\", \"dim\": \"心情失踪速度\"}, {\"title\": \"看到“拥抱变化”这种口号，我心里不仅毫无波澜，甚至有点想笑。\", \"dim\": \"希望蒸发阈值\"}, {\"title\": \"老板画的大饼，现在已经无法在我心里激起任何涟漪了。\", \"dim\": \"希望蒸发阈值\"}, {\"title\": \"想到“五年后的自己”，我脑子里是一片空白，或者干脆是另一个平行宇宙的画面。\", \"dim\": \"希望蒸发阈值\"}, {\"title\": \"我的电脑屏幕上永远开着至少一个看起来像工作文档的窗口。\", \"dim\": \"摸鱼伪装等级\"}, {\"title\": \"有人从我工位路过时，我的手指会下意识地在键盘上敲打几下。\", \"dim\": \"摸鱼伪装等级\"}, {\"title\": \"开会时我点头的频率和眼神的专注度，与我脑子里在想今晚吃啥完全无关。\", \"dim\": \"摸鱼伪装等级\"}, {\"title\": \"长假结束后，我需要花比假期更长的时间来重新适应工作节奏。\", \"dim\": \"重启失败率\"}, {\"title\": \"周末哪怕只是稍微想了想工作的事，周一上班的疲惫感就会直接翻倍。\", \"dim\": \"重启失败率\"}, {\"title\": \"定好的“明天一定好好干”计划，通常在第二天上午十点前就已宣告破产。\", \"dim\": \"重启失败率\"}, {\"title\": \"我对“升职加薪”路径的想象，清晰度还不如我昨晚做的梦。\", \"dim\": \"未来视野清晰度\"}, {\"title\": \"别人问我职业规划，我的回答通常是“走一步看一步”。\", \"dim\": \"未来视野清晰度\"}, {\"title\": \"我觉得现在的工作，和三年后可能在做的工作，之间没有任何必然联系。\", \"dim\": \"未来视野清晰度\"}, {\"title\": \"只要戴上耳机，我的工位就是一座与世隔绝的孤岛。\", \"dim\": \"工位结界强度\"}, {\"title\": \"我能精准感知到同事靠近的脚步声，并在对方开口前调整好“正在忙”的表情。\", \"dim\": \"工位结界强度\"}, {\"title\": \"午休时间，我的物理存在虽然在工位，但灵魂早已不知去向。\", \"dim\": \"工位结界强度\"}], \"resultTypes\": [{\"name\": \"秒速失踪型\", \"emoji\": \"🏃‍♂️💨\", \"emojiBg\": \"#E6F3FF\", \"desc\": \"你的工作心情像一阵风，来得快，去得更快。开机即失踪，开会即蒸发，是办公室里的头号失踪人口。维持热情对你来说，比维持体重还难。\", \"match\": \"心情失踪速度\"}, {\"name\": \"希望绝缘体\", \"emoji\": \"🛡️\", \"emojiBg\": \"#D1D8E0\", \"desc\": \"你对一切“未来可期”的言论自动免疫。饼画得再圆，也激不起你心里半点水花。你的希望蒸发点极高，或者说，已经蒸干了。处于一种“非常稳定”的绝望之中。\", \"match\": \"希望蒸发阈值\"}, {\"name\": \"伪装大师\", \"emoji\": \"🎭\", \"emojiBg\": \"#FFEAA7\", \"desc\": \"你的演技足以角逐办公室奥斯卡。看似专注，实则神游；看似忙碌，实则摸鱼。你将“出工不出力”演绎成了一门行为艺术，工位就是你的舞台。\", \"match\": \"摸鱼伪装等级\"}, {\"name\": \"重启困难户\", \"emoji\": \"🔁❌\", \"emojiBg\": \"#FD7272\", \"desc\": \"你的工作状态就像一台老旧电脑，关机容易，开机难。每次假期或间歇后，重启系统都要经历漫长的黑屏、卡顿和死机。不是不想工作，是身体和灵魂拒绝响应。\", \"match\": \"重启失败率\"}, {\"name\": \"未来迷雾症\", \"emoji\": \"🌫️\", \"emojiBg\": \"#CAD3C8\", \"desc\": \"你看不清前方的路。职业规划？人生愿景？这些词对你来说像是蒙上了一层浓雾。你活在当下的工位里，对未来的想象仅限于“明天还要上班”。\", \"match\": \"未来视野清晰度\"}, {\"name\": \"结界生成者\", \"emoji\": \"🧿\", \"emojiBg\": \"#9AECDB\", \"desc\": \"你拥有在工位瞬间展开个人结界的能力。耳机一戴，谁都不爱；眼神放空，世界清静。你成功地在喧嚣的办公室中，开辟出了一片属于自己的“虚无”空间。\", \"match\": \"工位结界强度\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"对暗恋对象的表达方式\", \"title\": \"你的暗恋，是什么画风？\", \"dims\": [\"线上考古深度\", \"动态发布策略\", \"互动试探频率\", \"内心戏丰富度\", \"行动力延迟\", \"自我复盘强度\"], \"qs\": [{\"title\": \"我能翻到对方三年前的社交动态。\", \"dim\": \"线上考古深度\"}, {\"title\": \"我会点进对方点赞过的陌生人的主页。\", \"dim\": \"线上考古深度\"}, {\"title\": \"我研究过对方社交账号的每一个关注和粉丝。\", \"dim\": \"线上考古深度\"}, {\"title\": \"我发过仅对方可见的朋友圈。\", \"dim\": \"动态发布策略\"}, {\"title\": \"我会精心编辑一条动态，发完又秒删。\", \"dim\": \"动态发布策略\"}, {\"title\": \"我的歌单/读书/观影记录里，有想被对方看见的暗号。\", \"dim\": \"动态发布策略\"}, {\"title\": \"我会给对方的动态点赞，但从不评论。\", \"dim\": \"互动试探频率\"}, {\"title\": \"我发消息前会反复斟酌用词和表情。\", \"dim\": \"互动试探频率\"}, {\"title\": \"对方回复慢一点，我就觉得是不是说错话了。\", \"dim\": \"互动试探频率\"}, {\"title\": \"对方一个标点符号，我能脑补出一部连续剧。\", \"dim\": \"内心戏丰富度\"}, {\"title\": \"我会反复点开聊天窗口，打了字又全部删掉。\", \"dim\": \"内心戏丰富度\"}, {\"title\": \"我觉得我们之间有种别人不懂的默契（虽然可能没有）。\", \"dim\": \"内心戏丰富度\"}, {\"title\": \"我想约对方出来，但永远停留在“下次再说”。\", \"dim\": \"行动力延迟\"}, {\"title\": \"我收藏了一堆攻略/话题，但一次也没用上。\", \"dim\": \"行动力延迟\"}, {\"title\": \"我觉得现在还不是时候，再等等。\", \"dim\": \"行动力延迟\"}, {\"title\": \"我会在深夜复盘和对方的每一句对话。\", \"dim\": \"自我复盘强度\"}, {\"title\": \"我后悔过某次没有发挥好的聊天。\", \"dim\": \"自我复盘强度\"}, {\"title\": \"我设想过无数种表白场景，但一种都没实践。\", \"dim\": \"自我复盘强度\"}], \"resultTypes\": [{\"name\": \"人形监控\", \"emoji\": \"🕵️\", \"emojiBg\": \"#2C3E50\", \"desc\": \"你的暗恋是一场精密的情报战。对方的社交足迹是你的研究课题，从三年前的动态到昨晚的点赞，你比大数据更懂TA。你的手机相册里，可能存着对方都忘了发过的截图。\", \"match\": \"线上考古深度\"}, {\"name\": \"赛博孔雀\", \"emoji\": \"🦚\", \"emojiBg\": \"#1ABC9C\", \"desc\": \"你的暗恋是一场精心策划的线上展览。每一条动态都是展品，仅TA可见是VIP通道。你的朋友圈是阅读理解题，而唯一的阅卷人，似乎从未交卷。\", \"match\": \"动态发布策略\"}, {\"name\": \"信号试探员\", \"emoji\": \"📡\", \"emojiBg\": \"#3498DB\", \"desc\": \"你的暗恋是一场谨慎的无线电通讯。点赞是心跳，撤回是犹豫。你发射了无数微弱的信号，然后在寂静中等待一个也许永远不会到来的回应，并为此焦虑一整天。\", \"match\": \"互动试探频率\"}, {\"name\": \"内心戏影帝/后\", \"emoji\": \"🎭\", \"emojiBg\": \"#9B59B6\", \"desc\": \"你的暗恋是一部自编自导自演的奥斯卡长片。对方一个眼神能让你写出一万字小说，一次擦肩而过就是命运的序章。你的大脑是最高效的造梦工厂，可惜观众只有你自己。\", \"match\": \"内心戏丰富度\"}, {\"name\": \"拖延症冠军\", \"emoji\": \"🐢\", \"emojiBg\": \"#16A085\", \"desc\": \"你的暗恋是一场永远在准备、从未能起跑的马拉松。“明天再说”“下次一定”“等个好时机”是你的口头禅。你的爱意很满，但行动力永远缺货，卡在“想”和“做”之间的，是一整个宇宙的犹豫。\", \"match\": \"行动力延迟\"}, {\"name\": \"复盘大师\", \"emoji\": \"📝\", \"emojiBg\": \"#F39C12\", \"desc\": \"你的暗恋是一场永无止境的赛后分析。深夜是你的复盘时间，聊天记录是你的分析文本。你会为一句没接住的话懊恼三天，也会为一个可爱的表情反复品味。你的爱意，在反复咀嚼中变得既深刻又疲惫。\", \"match\": \"自我复盘强度\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"你的外卖连续剧\", \"title\": \"你的外卖演到第几集了？\", \"dims\": [\"探索欲续航\", \"安全区粘性\", \"决策疲劳度\", \"仪式感浓度\", \"大结局触发点\"], \"qs\": [{\"title\": \"看到新店满减，我大概率会点进去看看。\", \"dim\": \"探索欲续航\"}, {\"title\": \"我手机里存着几家“不知道吃啥就点它”的店。\", \"dim\": \"安全区粘性\"}, {\"title\": \"光是“今天吃什么”这个问题，就能让我在App里刷半小时。\", \"dim\": \"决策疲劳度\"}, {\"title\": \"我试过为了凑满减，硬是点多了两个菜。\", \"dim\": \"仪式感浓度\"}, {\"title\": \"有过“算了，煮个泡面吧”的念头，并且真的执行了。\", \"dim\": \"大结局触发点\"}, {\"title\": \"我收藏过很多看起来不错的店，但最后都没点。\", \"dim\": \"探索欲续航\"}, {\"title\": \"同一家店的外卖，我能连续点一个星期。\", \"dim\": \"安全区粘性\"}, {\"title\": \"翻来翻去最后还是点了昨天那家，感觉像白逛了。\", \"dim\": \"决策疲劳度\"}, {\"title\": \"我觉得外卖到了要先摆好盘再吃，仪式感拉满。\", \"dim\": \"仪式感浓度\"}, {\"title\": \"当外卖又贵又难吃时，我会觉得不如自己动手。\", \"dim\": \"大结局触发点\"}, {\"title\": \"我对“商家招牌”或者“新品”有天然的好奇心。\", \"dim\": \"探索欲续航\"}, {\"title\": \"点新店踩雷后，我会更坚定地回归老店。\", \"dim\": \"安全区粘性\"}, {\"title\": \"选到最后，我经常是“随便吧，就这个了”的心态。\", \"dim\": \"决策疲劳度\"}, {\"title\": \"我会为了看剧下饭，特意点适合搭配的餐食。\", \"dim\": \"仪式感浓度\"}, {\"title\": \"当所有外卖都吃腻了的时候，泡面就是我的救赎。\", \"dim\": \"大结局触发点\"}], \"resultTypes\": [{\"name\": \"开荒先锋\", \"emoji\": \"🗺️\", \"emojiBg\": \"#4ECDC4\", \"desc\": \"你的探索欲永远满格，App首页的“新店”标签是你的快乐老家。敢于尝鲜，乐于踩雷，人生就是一场大型外卖测评。\", \"match\": \"探索欲续航\"}, {\"name\": \"黄焖鸡终身会员\", \"emoji\": \"🏆\", \"emojiBg\": \"#FF9F43\", \"desc\": \"你的安全区不是舒适圈，是堡垒。那几家老店就像你的食堂，闭着眼都知道点什么。不是不想尝试，是怕辜负了这份稳妥的安心。\", \"match\": \"安全区粘性\"}, {\"name\": \"选择困难晚期\", \"emoji\": \"🌀\", \"emojiBg\": \"#6C5CE7\", \"desc\": \"你的点餐流程是一场漫长的精神内耗。刷遍所有店铺，对比所有评价，最后在饿晕前随机选择一个。不是挑食，是选择太多，而你全都要想一遍。\", \"match\": \"决策疲劳度\"}, {\"name\": \"氛围组组长\", \"emoji\": \"🎬\", \"emojiBg\": \"#FF6B6B\", \"desc\": \"吃外卖？不，你是在进行一场个人用餐仪式。摆盘、选剧、调整灯光一气呵成。食物是道具，氛围才是正餐。\", \"match\": \"仪式感浓度\"}, {\"name\": \"泡面召唤师\", \"emoji\": \"🍜\", \"emojiBg\": \"#FECA57\", \"desc\": \"当外卖宇宙让你失望透顶，你总能精准召唤出那包泡面。这不是将就，是返璞归真，是阅尽千帆后的终极答案。你的连续剧，总以最朴素的片尾曲收场。\", \"match\": \"大结局触发点\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"摸鱼时的搜索引擎记录\", \"title\": \"你的摸鱼搜索，暴露了什么？\", \"dims\": [\"搜索主题的宏大性\", \"搜索路径的跳跃性\", \"搜索时长的隐蔽性\", \"搜索结果的实用性\", \"搜索后的行动力\"], \"qs\": [{\"title\": \"我搜索过“如何快速实现财务自由”或“副业月入过万”。\", \"dim\": \"搜索主题的宏大性\"}, {\"title\": \"我会在搜索“PPT怎么做”时，突然开始研究“如何养一只水豚”。\", \"dim\": \"搜索路径的跳跃性\"}, {\"title\": \"我能精准地在老板路过前，把搜索页面切回工作文档。\", \"dim\": \"搜索时长的隐蔽性\"}, {\"title\": \"我搜“附近哪家奶茶好喝”，会认真对比三家以上的评价。\", \"dim\": \"搜索结果的实用性\"}, {\"title\": \"我搜完“五分钟办公室拉伸”后，真的会站起来做两下。\", \"dim\": \"搜索后的行动力\"}, {\"title\": \"我搜过“三十岁转行还来得及吗”这种人生拷问。\", \"dim\": \"搜索主题的宏大性\"}, {\"title\": \"我的搜索记录从“Excel公式”到“猫为什么踩奶”毫无过渡。\", \"dim\": \"搜索路径的跳跃性\"}, {\"title\": \"我习惯用Alt+Tab切换窗口，手感比职业电竞选手还熟练。\", \"dim\": \"搜索时长的隐蔽性\"}, {\"title\": \"我连“中午吃什么”这种问题，都要看美食博主的十分钟测评。\", \"dim\": \"搜索结果的实用性\"}, {\"title\": \"我收藏了无数个“必看影单”和“自学技能”链接，再也没打开过。\", \"dim\": \"搜索后的行动力\"}, {\"title\": \"我认真研究过“如何靠投资加密货币改变命运”。\", \"dim\": \"搜索主题的宏大性\"}, {\"title\": \"我经常因为想查一个词的意思，最后在看完全部词条演变史。\", \"dim\": \"搜索路径的跳跃性\"}, {\"title\": \"我能根据办公室脚步声，判断是该最小化还是直接关页面。\", \"dim\": \"搜索时长的隐蔽性\"}, {\"title\": \"我买一卷胶带，会先看十篇“办公室好物推荐”笔记。\", \"dim\": \"搜索结果的实用性\"}, {\"title\": \"我搜完“高效工作法”的瞬间，就感到已经高效过了。\", \"dim\": \"搜索后的行动力\"}], \"resultTypes\": [{\"name\": \"战略规划型\", \"emoji\": \"🗺️\", \"emojiBg\": \"#4A90E2\", \"desc\": \"你的摸鱼搜索充满了对人生的宏大叙事，从财务自由到职业转型，每一秒的走神都在规划另一个平行宇宙的辉煌人生。虽然当前任务还没动，但未来的蓝图已经画到了80岁。\", \"match\": \"搜索主题的宏大性\"}, {\"name\": \"思维漫游者\", \"emoji\": \"🌀\", \"emojiBg\": \"#9B59B6\", \"desc\": \"你的搜索栏是意识流的跑马场。从一个正经问题出发，能经过八次毫无关联的跳转，最终停在一个完全意想不到的终点。你的浏览器历史，就是一部当代互联网迷因演化史。\", \"match\": \"搜索路径的跳跃性\"}, {\"name\": \"职场忍者\", \"emoji\": \"🥷\", \"emojiBg\": \"#2C3E50\", \"desc\": \"你拥有在工位结界内完美潜行的天赋。切屏手法快如闪电，听觉敏锐堪比雷达。在老板眼中你永远在专注工作，实际上你的精神已环游世界三周半。\", \"match\": \"搜索时长的隐蔽性\"}, {\"name\": \"考据派\", \"emoji\": \"🔍\", \"emojiBg\": \"#1ABC9C\", \"desc\": \"对你来说，摸鱼也是一门严谨的学问。哪怕只是决定午饭吃什么，你也要进行全面的市场调研、数据分析和口碑比对。你的每次搜索，都力求给出一个经得起推敲的答案。\", \"match\": \"搜索结果的实用性\"}, {\"name\": \"意念执行者\", \"emoji\": \"💭\", \"emojiBg\": \"#95A5A6\", \"desc\": \"搜索即完成，收藏即学会。你的行动力在点击“搜索”按钮的那一刻达到峰值，随后迅速衰减。你的收藏夹里住满了从未谋面的技能和计划，它们共同构成了一个“已阅”的平行世界。\", \"match\": \"搜索后的行动力\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"追星氪金能手\", \"title\": \"你的氪金DNA动了没？\", \"dims\": [\"重复购买耐受度\", \"周边囤积指数\", \"代言产品消费驱动力\", \"为爱发电续航力\", \"数据打投参与度\", \"同担互助倾向\"], \"qs\": [{\"title\": \"同一张专辑买好几张，就为了抽不同的小卡。\", \"dim\": \"重复购买耐受度\"}, {\"title\": \"拆到重复的卡或周边，第一反应是“正好可以换”。\", \"dim\": \"重复购买耐受度\"}, {\"title\": \"看到“限量”“绝版”这种词，钱包就自己打开了。\", \"dim\": \"重复购买耐受度\"}, {\"title\": \"家里有一面墙或者一个角落，专门用来摆周边。\", \"dim\": \"周边囤积指数\"}, {\"title\": \"买回来的PB（写真集）可能没翻几次，但必须拥有。\", \"dim\": \"周边囤积指数\"}, {\"title\": \"看到新出的官方周边，脑子里自动开始算这个月还剩多少预算。\", \"dim\": \"周边囤积指数\"}, {\"title\": \"爱豆代言了用不上的东西（比如男性护肤品），也会为了冲销量买。\", \"dim\": \"代言产品消费驱动力\"}, {\"title\": \"会因为谁家爱豆的代言title更高、销量更好，而产生微妙的比较心理。\", \"dim\": \"代言产品消费驱动力\"}, {\"title\": \"买代言产品时，“支持他”的想法超过了“我需要”。\", \"dim\": \"代言产品消费驱动力\"}, {\"title\": \"可以为了给爱豆做生日应援，提前好几个月开始攒钱。\", \"dim\": \"为爱发电续航力\"}, {\"title\": \"觉得“花钱”是表达喜欢最直接、最有用的方式之一。\", \"dim\": \"为爱发电续航力\"}, {\"title\": \"即使最近手头紧，看到特别想要的周边或专辑，还是会想办法“挤”出来。\", \"dim\": \"为爱发电续航力\"}, {\"title\": \"会参与超话签到、寻艺、明星权力榜这些日常打投。\", \"dim\": \"数据打投参与度\"}, {\"title\": \"为了冲音乐榜单或者投票，会特意开多个音乐App账号。\", \"dim\": \"数据打投参与度\"}, {\"title\": \"觉得“数据”是能让爱豆被更多人看到的重要指标。\", \"dim\": \"数据打投参与度\"}, {\"title\": \"会在粉丝群里互相提醒买代言、冲销量、做数据。\", \"dim\": \"同担互助倾向\"}, {\"title\": \"愿意把多余的周边或小卡，以很便宜的价格出给同担（相同粉丝）。\", \"dim\": \"同担互助倾向\"}, {\"title\": \"觉得和同担一起“为爱发电”的过程，本身也挺快乐的。\", \"dim\": \"同担互助倾向\"}], \"resultTypes\": [{\"name\": \"端水大师\", \"emoji\": \"⚖️\", \"emojiBg\": \"#6C5CE7\", \"desc\": \"重复购买？小意思。你深谙“鸡蛋不放在一个篮子里”的道理，买多份是为了雨露均沾，集齐所有可能性。拆重复不是损失，是另一种形式的资产配置。\", \"match\": \"重复购买耐受度\"}, {\"name\": \"仓鼠症晚期\", \"emoji\": \"🐹\", \"emojiBg\": \"#FDCB6E\", \"desc\": \"你的家，是爱豆周边的线下博物馆。拥有即快乐，摆着看就满足。空间规划？不存在的，爱会自己找到位置。你的收藏，是爱的实体化存档。\", \"match\": \"周边囤积指数\"}, {\"name\": \"行走的销量\", \"emoji\": \"💰\", \"emojiBg\": \"#00B894\", \"desc\": \"对你来说，爱豆的商务成绩单就是你的KPI。用不用得上不重要，排面必须给足。你不是在消费产品，你是在为爱豆的商业价值添砖加瓦。\", \"match\": \"代言产品消费驱动力\"}, {\"name\": \"永动机型粉\", \"emoji\": \"♾️\", \"emojiBg\": \"#0984E3\", \"desc\": \"你的爱自带续航电池，且支持快充。为爱发电不是一时冲动，是可持续的长期项目。预算？可以调整。热爱？永不枯竭。\", \"match\": \"为爱发电续航力\"}, {\"name\": \"数据女工/男工\", \"emoji\": \"📊\", \"emojiBg\": \"#636E72\", \"desc\": \"你坚信数据是互联网时代的硬通货。日常打卡已成肌肉记忆，关键时刻更能化身无情的数据机器。在你这里，爱意可以量化，且必须被看见。\", \"match\": \"数据打投参与度\"}, {\"name\": \"团战核心\", \"emoji\": \"🤝\", \"emojiBg\": \"#E84393\", \"desc\": \"你深知“独唯快，众唯远”的道理。乐于分享信息、互通有无，在粉丝社群里有很强的归属感和互助精神。对你来说，追星是集体作战的快乐。\", \"match\": \"同担互助倾向\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"单身沙发焊死\", \"title\": \"你的沙发焊死指数有多高？\", \"dims\": [\"启动难度\", \"续航时长\", \"位移半径\", \"补给依赖度\", \"环境耐受度\", \"社交断连指数\"], \"qs\": [{\"title\": \"周末早上醒来，第一反应是摸手机而不是起床。\", \"dim\": \"启动难度\"}, {\"title\": \"从“该起床了”到“算了再躺会儿”的念头转换，通常不超过三秒。\", \"dim\": \"启动难度\"}, {\"title\": \"一想到要出门，就觉得浑身力气被抽空。\", \"dim\": \"启动难度\"}, {\"title\": \"能在同一个姿势下，从下午一点刷手机刷到天黑。\", \"dim\": \"续航时长\"}, {\"title\": \"午觉睡醒，发现天黑了，第一反应是“正好接着睡”。\", \"dim\": \"续航时长\"}, {\"title\": \"周末两天，感觉只过了“白天”和“晚上”两个时段。\", \"dim\": \"续航时长\"}, {\"title\": \"外卖到了，会精确计算从沙发到门口的最短路径。\", \"dim\": \"位移半径\"}, {\"title\": \"遥控器、手机、充电宝，必须在我一臂之内的“结界”里。\", \"dim\": \"位移半径\"}, {\"title\": \"上厕所是唯一能让我离开沙发的正当理由，且速去速回。\", \"dim\": \"位移半径\"}, {\"title\": \"冰箱空了，第一选择是点外卖，而不是下楼买菜。\", \"dim\": \"补给依赖度\"}, {\"title\": \"会为了凑满减，点够吃两顿的外卖。\", \"dim\": \"补给依赖度\"}, {\"title\": \"水杯就在茶几上，但懒得伸手，宁愿渴一会儿。\", \"dim\": \"补给依赖度\"}, {\"title\": \"沙发上堆着衣服、零食、充电线，但我觉得很自在。\", \"dim\": \"环境耐受度\"}, {\"title\": \"阳光晒到脚了，就挪一下脚，而不是起身拉窗帘。\", \"dim\": \"环境耐受度\"}, {\"title\": \"能忍受手机只剩5%的电，只要充电线够得着。\", \"dim\": \"环境耐受度\"}, {\"title\": \"朋友约饭，我第一反应是“能不能改天”。\", \"dim\": \"社交断连指数\"}, {\"title\": \"看到未接来电，只要不是老板，就先回个微信。\", \"dim\": \"社交断连指数\"}, {\"title\": \"觉得最好的社交，就是各自在家连麦打游戏。\", \"dim\": \"社交断连指数\"}], \"resultTypes\": [{\"name\": \"焊丝级\", \"emoji\": \"🔩\", \"emojiBg\": \"#7F8C8D\", \"desc\": \"启动即焊死，位移全靠意念。你的沙发不是家具，是你的共生体。周末对你来说不是休息，是进入一种低功耗的待机状态。\", \"match\": \"启动难度\"}, {\"name\": \"长续航型\", \"emoji\": \"⏳\", \"emojiBg\": \"#3498DB\", \"desc\": \"电量惊人，一瘫到底。你的周末不是按小时过的，是按“刷完几个剧”和“睡了几觉”来计算的。太阳起落，与你无关。\", \"match\": \"续航时长\"}, {\"name\": \"结界大师\", \"emoji\": \"🌀\", \"emojiBg\": \"#9B59B6\", \"desc\": \"以沙发为圆心，一臂距离为半径，画地为牢。在这个结界里，你拥有绝对的控制权。出了结界？那是什么，没听说过。\", \"match\": \"位移半径\"}, {\"name\": \"全自动补给\", \"emoji\": \"🤖\", \"emojiBg\": \"#E74C3C\", \"desc\": \"你的生存系统已高度外卖化。食物、水、快乐，全部由骑手和快递员输送。你的手只负责点击屏幕和开门。\", \"match\": \"补给依赖度\"}, {\"name\": \"废墟生存者\", \"emoji\": \"🏚️\", \"emojiBg\": \"#95A5A6\", \"desc\": \"对环境的要求低到令人发指。乱？那是生活气息。不舒服？挪一下就好了。只要沙发还在，哪里都是宫殿。\", \"match\": \"环境耐受度\"}, {\"name\": \"信号屏蔽仪\", \"emoji\": \"📵\", \"emojiBg\": \"#2C3E50\", \"desc\": \"主动切断了与外界的大部分物理连接。社交？线上可以，线下免谈。你的世界很小，但很完整，就在这方寸之间。\", \"match\": \"社交断连指数\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"办公室恋情观察家\", \"title\": \"你的同事恋爱雷达有多强？\", \"dims\": [\"情报收集能力\", \"动态追踪精度\", \"内心OS丰富度\", \"自我代入倾向\", \"关系预测准确率\", \"个人感情绝缘度\"], \"qs\": [{\"title\": \"我总能第一时间发现谁和谁用了同款手机壳。\", \"dim\": \"情报收集能力\"}, {\"title\": \"同事朋友圈的定位、点赞、评论，我基本能拼出个故事线。\", \"dim\": \"情报收集能力\"}, {\"title\": \"茶水间里谁多看了谁一眼，我事后能复盘出至少三种可能性。\", \"dim\": \"情报收集能力\"}, {\"title\": \"我知道A和B的午休时间，最近从错开变成了重合。\", \"dim\": \"动态追踪精度\"}, {\"title\": \"我能准确说出C和D是从哪次团建后开始互称“老师”的。\", \"dim\": \"动态追踪精度\"}, {\"title\": \"谁今天没带饭，大概率是约了谁一起下楼吃，我猜得八九不离十。\", \"dim\": \"动态追踪精度\"}, {\"title\": \"看到两个同事一起下楼拿咖啡，我心里已经演完了一集偶像剧。\", \"dim\": \"内心OS丰富度\"}, {\"title\": \"他们工作沟通时语气稍微正式一点，我就觉得“完了，吵架了”。\", \"dim\": \"内心OS丰富度\"}, {\"title\": \"我会默默给观察到的CP起代号，比如“打印机旁的爱情”。\", \"dim\": \"内心OS丰富度\"}, {\"title\": \"看到别人恋爱顺利，我会忍不住想“这要是我该多好”。\", \"dim\": \"自我代入倾向\"}, {\"title\": \"分析同事恋情时，我常会不自觉地套用“如果是我，我会……”。\", \"dim\": \"自我代入倾向\"}, {\"title\": \"我甚至想过，他们吵架了该找谁调解，预案里包括我自己。\", \"dim\": \"自我代入倾向\"}, {\"title\": \"我预言过“这俩不出三个月必在一起”，后来真的成了。\", \"dim\": \"关系预测准确率\"}, {\"title\": \"我说“他们看着快分了”，没多久就看到其中一个人换了情头。\", \"dim\": \"关系预测准确率\"}, {\"title\": \"我凭感觉判断的“地下恋情”，最后都被实锤了。\", \"dim\": \"关系预测准确率\"}, {\"title\": \"我对自己的感情问题，远没有对同事的八卦上心。\", \"dim\": \"个人感情绝缘度\"}, {\"title\": \"朋友问我“你呢？”，我的标准回答是“先嗑别人的，我的随缘”。\", \"dim\": \"个人感情绝缘度\"}, {\"title\": \"我能把别人的恋爱线分析得头头是道，自己的聊天记录却一片空白。\", \"dim\": \"个人感情绝缘度\"}], \"resultTypes\": [{\"name\": \"人形监控探头\", \"emoji\": \"📡\", \"emojiBg\": \"#5DADE2\", \"desc\": \"你的情报网密不透风，茶水间的眼神、朋友圈的点赞、同款的一切都逃不过你的法眼。你是办公室的活体数据库，没有你不知道的暗流涌动。\", \"match\": \"情报收集能力\"}, {\"name\": \"显微镜女孩/男孩\", \"emoji\": \"🔬\", \"emojiBg\": \"#48C9B0\", \"desc\": \"你的观察精度令人发指。能从工位距离的微妙变化、称呼的语气转变中，精准捕捉到关系的每一个发展阶段。你不是在吃瓜，你是在做田野调查。\", \"match\": \"动态追踪精度\"}, {\"name\": \"内心戏编剧\", \"emoji\": \"🎭\", \"emojiBg\": \"#AF7AC5\", \"desc\": \"你的内心世界比看到的剧情精彩十倍。同事间一个普通的互动，在你脑海里已经完成了从相遇、误会、和解到撒糖的全套剧本。你嗑的CP，你自己负责产粮。\", \"match\": \"内心OS丰富度\"}, {\"name\": \"沉浸式观众\", \"emoji\": \"🛋️\", \"emojiBg\": \"#F1948A\", \"desc\": \"你看别人的恋爱，就像在看一场沉浸式戏剧，常常不自觉地把自己代入进去。你会为他们着急，为他们开心，甚至偷偷规划“如果是我”的剧情线。\", \"match\": \"自我代入倾向\"}, {\"name\": \"预言家\", \"emoji\": \"🔮\", \"emojiBg\": \"#BB8FCE\", \"desc\": \"你的直觉准得吓人。你说“有戏”的，后来都牵了手；你说“悬了”的，没多久就分了。同事开始把你当半仙，有新动向都想先听听你的判断。\", \"match\": \"关系预测准确率\"}, {\"name\": \"嗑学大师\", \"emoji\": \"🍉\", \"emojiBg\": \"#F7DC6F\", \"desc\": \"你精通一切恋爱信号学，是同事眼中的情感专家。但你的技能点似乎全点在了“观察”和“分析”上，轮到自己的感情故事时，剧本永远停留在第一页。别人的瓜又大又甜，自己的地还没开垦。\", \"match\": \"个人感情绝缘度\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"单身时长换算\", \"title\": \"你的单身时长，够干点啥？\", \"dims\": [\"名著阅读进度\", \"独食技能点\", \"自我对话深度\", \"社交雷达灵敏度\", \"时间感知扭曲度\", \"应急预案完备度\"], \"qs\": [{\"title\": \"我确实能说出《红楼梦》里几个丫鬟的名字，或者《水浒传》里几个好汉的绰号。\", \"dim\": \"名著阅读进度\"}, {\"title\": \"无聊的时候，我真的会打开电子书或者听书APP，看/听点经典名著。\", \"dim\": \"名著阅读进度\"}, {\"title\": \"我觉得用“够看三遍四大名著”来形容一段空窗期，挺贴切的。\", \"dim\": \"名著阅读进度\"}, {\"title\": \"我一个人去吃火锅/烤肉，服务员问“几位”时，我能非常坦然地说“一位”。\", \"dim\": \"独食技能点\"}, {\"title\": \"我知道哪家餐厅对单人食客最友好（比如有小份菜、有吧台位、不会急着收碗）。\", \"dim\": \"独食技能点\"}, {\"title\": \"我觉得一个人吃饭刷手机，比跟不熟的人尬聊舒服多了。\", \"dim\": \"独食技能点\"}, {\"title\": \"我经常在脑子里自己跟自己辩论，或者预演一段根本不会发生的对话。\", \"dim\": \"自我对话深度\"}, {\"title\": \"深夜睡不着的时候，我会在脑海里给自己放电影，情节还挺完整。\", \"dim\": \"自我对话深度\"}, {\"title\": \"我觉得跟自己相处，比跟一些需要费心维护关系的人相处更省电。\", \"dim\": \"自我对话深度\"}, {\"title\": \"我能快速判断出聚会里谁和谁可能有点苗头，或者谁在暗恋谁。\", \"dim\": \"社交雷达灵敏度\"}, {\"title\": \"朋友的感情问题，我经常能给出听起来挺有道理的分析（虽然自己的问题一塌糊涂）。\", \"dim\": \"社交雷达灵敏度\"}, {\"title\": \"看到别人秀恩爱，我的第一反应是分析他们能谈多久，而不是羡慕。\", \"dim\": \"社交雷达灵敏度\"}, {\"title\": \"我感觉周末两天过得特别快，但回想上个情人节/七夕，又觉得好像过去很久了。\", \"dim\": \"时间感知扭曲度\"}, {\"title\": \"用“上次谈恋爱还是iPhone X刚出的时候”来描述时间，对我来说很自然。\", \"dim\": \"时间感知扭曲度\"}, {\"title\": \"我对“纪念日”“情人节”这种日期越来越不敏感，经常过后才想起来。\", \"dim\": \"时间感知扭曲度\"}, {\"title\": \"我设想过如果一直单身到老，我的养老计划和资金安排。\", \"dim\": \"应急预案完备度\"}, {\"title\": \"家里常备着一些“一个人也能搞定”的娱乐或技能，比如拼图、乐器、游戏机。\", \"dim\": \"应急预案完备度\"}, {\"title\": \"我觉得“孤独终老”听起来有点惨，但“自由到老”好像也还行。\", \"dim\": \"应急预案完备度\"}], \"resultTypes\": [{\"name\": \"文学博士预备役\", \"emoji\": \"📚\", \"emojiBg\": \"#8B4513\", \"desc\": \"你的单身时长，足以让你在文学的海洋里遨游好几个来回。四大名著？那是基础读物。你可能已经开始研究《尤利西斯》或者《追忆似水年华》了。时间在你这里，被换算成了扎实的阅读量和满腹的（没什么用的）经纶。\", \"match\": \"名著阅读进度\"}, {\"name\": \"孤独美食家\", \"emoji\": \"🍲\", \"emojiBg\": \"#FF6B6B\", \"desc\": \"一人食对你来说不是将就，而是一门精研的艺术。你知道哪家的吧台不尴尬，哪家的小份菜最实惠，如何优雅地应对“一位吗”的询问。你的单身时长，完美转化为了城市美食地图的探索进度条。\", \"match\": \"独食技能点\"}, {\"name\": \"内心戏影帝/影后\", \"emoji\": \"🎭\", \"emojiBg\": \"#9B59B6\", \"desc\": \"你的内心世界比一部连续剧还精彩。漫长的独处时光，让你练就了自编自导自演的全套技能。脑内小剧场常年不休，从哲学辩论到浪漫邂逅，应有尽有。外在风平浪静，内在波澜壮阔。\", \"match\": \"自我对话深度\"}, {\"name\": \"人间清醒观察员\", \"emoji\": \"🔍\", \"emojiBg\": \"#3498DB\", \"desc\": \"旁观者清。长期的“在场外观赛”经验，让你的情感雷达异常敏锐。你能一眼看穿暧昧的信号、关系的裂痕，分析起别人的感情头头是道，像个情感专家——尽管这份智慧暂时只服务于你的朋友们。\", \"match\": \"社交雷达灵敏度\"}, {\"name\": \"时间感知失调者\", \"emoji\": \"⏳\", \"emojiBg\": \"#BDC3C7\", \"desc\": \"你的时间感是薛定谔的。关于单身的日子，既觉得“一晃就这么久了”，又觉得某些细节“仿佛就在昨天”。你用科技产品的迭代、流行文化的变迁来丈量时间，而不是恋爱纪念日。\", \"match\": \"时间感知扭曲度\"}, {\"name\": \"末日生存规划师\", \"emoji\": \"🗺️\", \"emojiBg\": \"#2ECC71\", \"desc\": \"你不仅接受了单身可能长期化的设定，还为此制定了详尽的“应急预案”。从经济储备到精神建设，从养老选址到兴趣爱好培养，你致力于把一个人的生活经营成一座坚固且自得其乐的堡垒。\", \"match\": \"应急预案完备度\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"下班光速消失术\", \"title\": \"你下班后消失得有多快？\", \"dims\": [\"启动预警\", \"撤离速度\", \"断网指数\", \"归巢本能\", \"多待一秒亏钱感\"], \"qs\": [{\"title\": \"我下午就开始盘算下班后要干嘛，精确到分钟。\", \"dim\": \"启动预警\"}, {\"title\": \"离下班还有半小时，我的工作状态就已经是“待机”了。\", \"dim\": \"启动预警\"}, {\"title\": \"我会在最后一分钟把电脑桌面整理得干干净净，为关机做准备。\", \"dim\": \"启动预警\"}, {\"title\": \"下班时间一到，我关电脑的速度比闪电还快。\", \"dim\": \"撤离速度\"}, {\"title\": \"我能做到打卡、关灯、锁门、进电梯一气呵成，中间不带停顿。\", \"dim\": \"撤离速度\"}, {\"title\": \"同事想下班后聊两句，我通常已经走到电梯口了。\", \"dim\": \"撤离速度\"}, {\"title\": \"下班后，工作群的消息我基本是第二天早上才看。\", \"dim\": \"断网指数\"}, {\"title\": \"离开公司大楼，我就感觉自己和“打工人”这个身份暂时解绑了。\", \"dim\": \"断网指数\"}, {\"title\": \"周末或假期，我的工作软件是绝对不会打开的。\", \"dim\": \"断网指数\"}, {\"title\": \"我下班后的目的地非常明确，不是回家就是直奔某个约好的地方。\", \"dim\": \"归巢本能\"}, {\"title\": \"家里有猫/狗/植物/游戏在等我，是我下班飞奔的最大动力。\", \"dim\": \"归巢本能\"}, {\"title\": \"我觉得下班后的时间才是真正属于我自己的“生活时间”。\", \"dim\": \"归巢本能\"}, {\"title\": \"加班？除非给钱，不然多待一秒我都觉得血亏。\", \"dim\": \"多待一秒亏钱感\"}, {\"title\": \"下班后如果被临时叫住干活，我心里会开始计算“时薪损失”。\", \"dim\": \"多待一秒亏钱感\"}, {\"title\": \"我认为下班后的自由时光，是上班辛苦一天应得的“利息”。\", \"dim\": \"多待一秒亏钱感\"}], \"resultTypes\": [{\"name\": \"预谋型撤离\", \"emoji\": \"⏰\", \"emojiBg\": \"#FF9F43\", \"desc\": \"你的消失不是偶然，是一场从下午就开始精心策划的“越狱”。时间管理大师，撤退路线早已在心中演练了八百遍。\", \"match\": \"启动预警\"}, {\"name\": \"瞬移选手\", \"emoji\": \"⚡\", \"emojiBg\": \"#FFD93D\", \"desc\": \"下班铃是你的发令枪。别人眼里你只是晃了一下，人就已经在电梯里了。留下一个残影和同事们“人呢？”的疑问。\", \"match\": \"撤离速度\"}, {\"name\": \"人间蒸发模式\", \"emoji\": \"📵\", \"emojiBg\": \"#6C5CE7\", \"desc\": \"下班即断联，工作号已离线。你的夜晚是一座孤岛，公司的信号根本漂不过去。同事想捞你？等明天上班吧。\", \"match\": \"断网指数\"}, {\"name\": \"精准归巢\", \"emoji\": \"🏠\", \"emojiBg\": \"#FF6B6B\", \"desc\": \"你的下班轨迹像被设定好的导航，终点永远是那个让你放松的“巢穴”。无论是家的沙发，还是朋友的酒局，到了才算真正下班。\", \"match\": \"归巢本能\"}, {\"name\": \"一秒千金\", \"emoji\": \"💰\", \"emojiBg\": \"#1DD1A1\", \"desc\": \"在你看来，下班后的每一秒自由都明码标价。无偿占用？那是在抢劫你的个人时间。你的边界感，是用“亏了”来计算的。\", \"match\": \"多待一秒亏钱感\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"催婚压力测试仪\", \"title\": \"你的催婚抗压表，还剩几格电？\", \"dims\": [\"血压飙升阈值\", \"话题闪避成功率\", \"内心OS丰富度\", \"反催婚弹药库\", \"亲情电量消耗率\", \"自我说服强度\"], \"qs\": [{\"title\": \"听到“你看那谁家孩子都二胎了”，我第一反应是血压往上顶。\", \"dim\": \"血压飙升阈值\"}, {\"title\": \"亲戚说“再不找就没人要了”，我能当场笑出来，但心里已经在骂街。\", \"dim\": \"血压飙升阈值\"}, {\"title\": \"被问到“你到底想找个什么样的”，我会瞬间进入战斗状态。\", \"dim\": \"血压飙升阈值\"}, {\"title\": \"我熟练掌握“工作忙”“没遇到合适的”“随缘”三件套。\", \"dim\": \"话题闪避成功率\"}, {\"title\": \"我能把话题从“找对象”自然引到“阿姨您广场舞跳得真好”。\", \"dim\": \"话题闪避成功率\"}, {\"title\": \"饭桌上，我会主动挑起其他亲戚家孩子的八卦来转移火力。\", \"dim\": \"话题闪避成功率\"}, {\"title\": \"表面微笑点头，心里已经在演“关你屁事”的八百字小作文。\", \"dim\": \"内心OS丰富度\"}, {\"title\": \"我会默默给催婚的亲戚们脑补一出“晚年孤独但嘴硬”的连续剧。\", \"dim\": \"内心OS丰富度\"}, {\"title\": \"被催时，我连未来孩子叫什么、学区房买哪都在脑子里过了一遍，就是不动弹。\", \"dim\": \"内心OS丰富度\"}, {\"title\": \"我手机里存着“婚姻不幸案例集锦”，必要时可以脱口而出。\", \"dim\": \"反催婚弹药库\"}, {\"title\": \"我能用“现在离婚率多高啊”“一个人过得可爽了”进行温和反击。\", \"dim\": \"反催婚弹药库\"}, {\"title\": \"我甚至准备过“我有隐疾”这种核武器选项，虽然从没用过。\", \"dim\": \"反催婚弹药库\"}, {\"title\": \"一顿催婚饭下来，我感觉比加三天班还累，只想瘫着。\", \"dim\": \"亲情电量消耗率\"}, {\"title\": \"过年回家七天，我的社交能量在第三天就见底了。\", \"dim\": \"亲情电量消耗率\"}, {\"title\": \"每次耐心解释完，我都觉得和家人的理解又远了一点，特别耗神。\", \"dim\": \"亲情电量消耗率\"}, {\"title\": \"深夜我也会想，“是不是真的该随便找个人算了”。\", \"dim\": \"自我说服强度\"}, {\"title\": \"看到朋友结婚晒幸福，我会有那么一瞬间怀疑自己的坚持。\", \"dim\": \"自我说服强度\"}, {\"title\": \"但最终，我总能用自己的逻辑把“不能将就”这个道理重新焊死在脑子里。\", \"dim\": \"自我说服强度\"}], \"resultTypes\": [{\"name\": \"一点就炸型\", \"emoji\": \"💥\", \"emojiBg\": \"#FF6B6B\", \"desc\": \"你的血压和催婚话题绑定，亲戚开口即红温。防御模式是“怼回去”，虽然很爽，但战后修复工程比较大。\", \"match\": \"血压飙升阈值\"}, {\"name\": \"闪避大师\", \"emoji\": \"🥷\", \"emojiBg\": \"#48DBFB\", \"desc\": \"你深谙太极之道，总能以柔克刚，把催婚话题化于无形。亲戚的拳头打在棉花上，而你已飘然离去，深藏功与名。\", \"match\": \"话题闪避成功率\"}, {\"name\": \"内心戏冠军\", \"emoji\": \"🎭\", \"emojiBg\": \"#A29BFE\", \"desc\": \"表面风平浪静，甚至保持微笑，内心早已上演了八十集爱恨情仇伦理剧。你的沉默，是最大的爆发。\", \"match\": \"内心OS丰富度\"}, {\"name\": \"反催婚军火商\", \"emoji\": \"🧨\", \"emojiBg\": \"#FF9F43\", \"desc\": \"你从不打无准备之仗，手机里存满了数据、案例和诡辩逻辑。催婚？这是你展示知识储备和辩论技巧的舞台。\", \"match\": \"反催婚弹药库\"}, {\"name\": \"低电量焦虑者\", \"emoji\": \"🪫\", \"emojiBg\": \"#95AFBA\", \"desc\": \"亲情是耗电巨快的APP。每次家庭聚会都像一次极限续航测试，结束后必须长时间独处才能缓慢回血。\", \"match\": \"亲情电量消耗率\"}, {\"name\": \"信念摇摆者\", \"emoji\": \"🔄\", \"emojiBg\": \"#D6D6D6\", \"desc\": \"你在“坚持自我”和“妥协算了”之间反复横跳。夜晚的自我怀疑和清晨的重新坚定，构成了你的日常循环。\", \"match\": \"自我说服强度\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"恋爱经济学入门\", \"title\": \"你的恋爱性价比算明白了吗？\", \"dims\": [\"时间成本核算\", \"情绪价值ROI\", \"沉没成本敏感度\", \"机会成本意识\", \"风险对冲能力\"], \"qs\": [{\"title\": \"我算过和对象约会一次，路上加吃饭加聊天，平均要花掉我4个小时。\", \"dim\": \"时间成本核算\"}, {\"title\": \"如果周末要陪对象，我会提前把工作和其他事都往前赶，感觉像在还时间债。\", \"dim\": \"时间成本核算\"}, {\"title\": \"我觉得“没时间”是比“没钱”更正当的分手理由。\", \"dim\": \"时间成本核算\"}, {\"title\": \"对方给我提供的情绪价值，大部分时候抵得上我付出的时间和精力。\", \"dim\": \"情绪价值ROI\"}, {\"title\": \"吵完架后对方哄我的方式，决定了这次吵架是“亏损”还是“盈利”。\", \"dim\": \"情绪价值ROI\"}, {\"title\": \"我觉得谈恋爱最大的收益不是礼物，是有人能接住我半夜的废话。\", \"dim\": \"情绪价值ROI\"}, {\"title\": \"在一段明显不合适的关系里，我拖得越久，越是因为“都投入这么多了”。\", \"dim\": \"沉没成本敏感度\"}, {\"title\": \"分手后我最难受的不是失去这个人，是觉得过去的时间全白给了。\", \"dim\": \"沉没成本敏感度\"}, {\"title\": \"我为对方改掉的习惯、放弃的爱好，在分手后会让我格外愤怒。\", \"dim\": \"沉没成本敏感度\"}, {\"title\": \"单身时看到朋友秀恩爱，我羡慕的不是爱情，是“他们好像找到了更优解”。\", \"dim\": \"机会成本意识\"}, {\"title\": \"我会想，如果没谈恋爱，这笔钱我本来可以买台新游戏机/报个兴趣班。\", \"dim\": \"机会成本意识\"}, {\"title\": \"决定开始一段关系前，我会下意识盘点自己即将让渡的“个人自由”。\", \"dim\": \"机会成本意识\"}, {\"title\": \"我不会把所有的情绪出口都押在对象一个人身上。\", \"dim\": \"风险对冲能力\"}, {\"title\": \"就算在热恋期，我也保持着一两个完全属于自己的社交圈或爱好。\", \"dim\": \"风险对冲能力\"}, {\"title\": \"我觉得好的恋爱不是雪中送炭，是锦上添花——我自己这匹锦本来就不错。\", \"dim\": \"风险对冲能力\"}], \"resultTypes\": [{\"name\": \"时间精算师\", \"emoji\": \"⏱️\", \"emojiBg\": \"#5D9CEC\", \"desc\": \"你的恋爱像在跑项目，每个工时都记在心里的甘特图上。约会不是享受，是时间资产的定向投资。\", \"match\": \"时间成本核算\"}, {\"name\": \"情绪价值股东\", \"emoji\": \"📈\", \"emojiBg\": \"#FF9F43\", \"desc\": \"你谈的不是恋爱，是情绪股市。对方的每一句安慰都是K线，每一次争吵都是回调。你在乎长期持有价值。\", \"match\": \"情绪价值ROI\"}, {\"name\": \"沉没成本囚徒\", \"emoji\": \"⛓️\", \"emojiBg\": \"#A8A8A8\", \"desc\": \"你被自己过去的投入锁死了。明明知道该止损，但“已经付出那么多”的念头，比任何感情都更牢固。\", \"match\": \"沉没成本敏感度\"}, {\"name\": \"机会成本侦探\", \"emoji\": \"🔍\", \"emojiBg\": \"#48CFAD\", \"desc\": \"你永远在算那本看不见的账。每一个拥抱的代价，可能是一次说走就走的旅行。你爱得清醒，也爱得计较。\", \"match\": \"机会成本意识\"}, {\"name\": \"风险对冲高手\", \"emoji\": \"🛡️\", \"emojiBg\": \"#4FC1E9\", \"desc\": \"你的感情配置多元化。爱情只是投资组合的一部分，永远不会All in。分手对你来说不是爆仓，只是调仓。\", \"match\": \"风险对冲能力\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"前任大数据分析师\", \"title\": \"你的前任情报学，修到第几层了？\", \"dims\": [\"数据源广度\", \"信息挖掘深度\", \"分析响应速度\", \"关联推理强度\", \"自我说服倾向\", \"行为克制指数\"], \"qs\": [{\"title\": \"我至少会同时监控对方三个以上的社交平台动态。\", \"dim\": \"数据源广度\"}, {\"title\": \"网易云歌单里突然多了一首苦情歌，我会立刻警觉。\", \"dim\": \"数据源广度\"}, {\"title\": \"我连对方豆瓣标记的“想读”书单更新了都会注意到。\", \"dim\": \"数据源广度\"}, {\"title\": \"我能从对方微博点赞的博主里，推测出TA最近可能认识了什么人。\", \"dim\": \"信息挖掘深度\"}, {\"title\": \"我会把对方网易云最近一周的听歌时间、风格变化做成趋势图（在脑子里）。\", \"dim\": \"信息挖掘深度\"}, {\"title\": \"对方抖音新关注了谁，我会点进去看那个人的所有视频，寻找关联线索。\", \"dim\": \"信息挖掘深度\"}, {\"title\": \"对方社交动态一更新，我五分钟内就会收到“心灵感应”并点开查看。\", \"dim\": \"分析响应速度\"}, {\"title\": \"深夜发现对方网易云在线，我会立刻开始分析TA此刻可能的心情。\", \"dim\": \"分析响应速度\"}, {\"title\": \"朋友无意中提起TA的近况，我当晚就会去验证所有相关线索。\", \"dim\": \"分析响应速度\"}, {\"title\": \"看到TA给一条普通风景照点赞，我会想“这地方是不是跟别人去的”。\", \"dim\": \"关联推理强度\"}, {\"title\": \"TA分享了一首欢快的歌，我反而觉得是在强颜欢笑，掩饰低落。\", \"dim\": \"关联推理强度\"}, {\"title\": \"哪怕TA只是换了个微信头像，我也能脑补出一场情感大戏。\", \"dim\": \"关联推理强度\"}, {\"title\": \"即使所有证据都指向“TA过得很好”，我也能找到一两个细节证明“TA可能还在意”。\", \"dim\": \"自我说服倾向\"}, {\"title\": \"我会把TA偶尔手滑的点赞，解读成“故意让我看见的信号”。\", \"dim\": \"自我说服倾向\"}, {\"title\": \"分析到最后，结论经常是“TA应该还没完全放下”。\", \"dim\": \"自我说服倾向\"}, {\"title\": \"我能在深夜分析得泪流满面，但绝不会手滑点赞或访问对方空间。\", \"dim\": \"行为克制指数\"}, {\"title\": \"就算推测出TA可能有新欢，我也绝不会去问共同朋友求证。\", \"dim\": \"行为克制指数\"}, {\"title\": \"我的所有侦查行为，都停留在“自己知道就好”的层面。\", \"dim\": \"行为克制指数\"}], \"resultTypes\": [{\"name\": \"全域监控型\", \"emoji\": \"📡\", \"emojiBg\": \"#5D7B93\", \"desc\": \"你的数据雷达24小时开机，覆盖范围从微博到网易云，从豆瓣到抖音。你不是在视奸，你是在做全网舆情监控。朋友问你“怎么什么都知道”，你笑而不语，深藏功与名。\", \"match\": \"数据源广度\"}, {\"name\": \"深度矿工\", \"emoji\": \"⛏️\", \"emojiBg\": \"#7E8C8D\", \"desc\": \"给你一个点赞，你能挖出一部连续剧。你擅长从最微不足道的痕迹里，还原出完整的情感现场。你的分析报告细节丰富、逻辑缜密，缺的只是一个愿意听你汇报的客户（而那个客户本该是TA）。\", \"match\": \"信息挖掘深度\"}, {\"name\": \"实时告警机\", \"emoji\": \"🚨\", \"emojiBg\": \"#FF6B6B\", \"desc\": \"你的情感预警系统响应速度以秒计。对方动态即是你行动的号角。你不是反应快，你是根本没关掉那个后台进程。你的心跳，常常随着对方社交APP的在线状态指示灯一同明灭。\", \"match\": \"分析响应速度\"}, {\"name\": \"阴谋论大师\", \"emoji\": \"🕵️\", \"emojiBg\": \"#2C3E50\", \"desc\": \"在你眼里，没有巧合，全是伏笔。一条普通的动态背后，可能藏着三层隐喻和五次眼神交汇。你构建的叙事逻辑之强大，连原作者（你的前任）看了都会震惊：“我当时是这么想的吗？”\", \"match\": \"关联推理强度\"}, {\"name\": \"自我攻略型\", \"emoji\": \"💭\", \"emojiBg\": \"#A29BFE\", \"desc\": \"数据是客观的，但你的解读永远是朝向“还有希望”的方向进行微调。你拥有在废墟中找到一颗糖的非凡能力。你的分析，与其说是为了看清对方，不如说是为了说服自己。\", \"match\": \"自我说服倾向\"}, {\"name\": \"赛博忍者\", \"emoji\": \"🥷\", \"emojiBg\": \"#4A4A4A\", \"desc\": \"你在数字世界踏雪无痕。所有的惊涛骇浪、抽丝剥茧，都发生在你的颅内剧场。表面风平浪静，甚至还能给共同朋友点个赞。你的克制，是你留给这段关系最后的、也是唯一的体面。\", \"match\": \"行为克制指数\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"塑料爱情质检员\", \"title\": \"你的爱情雷达，能扫出多少塑料？\", \"dims\": [\"微表情捕捉力\", \"文案破译能力\", \"场景违和感雷达\", \"历史动态交叉比对能力\", \"直觉预警灵敏度\", \"拆穿后的反应模式\"], \"qs\": [{\"title\": \"我能从合照里两个人的肩膀倾斜角度，判断谁在主动靠近谁。\", \"dim\": \"微表情捕捉力\"}, {\"title\": \"看到“他对我真的很好”这种万能文案，我第一反应是“具体好在哪？”。\", \"dim\": \"微表情捕捉力\"}, {\"title\": \"如果一方笑出牙龈，另一方只是嘴角礼貌上扬，我会觉得这场恩爱秀得很辛苦。\", \"dim\": \"微表情捕捉力\"}, {\"title\": \"“我们”这个词出现频率突然暴增的官宣文案，我会觉得有点刻意。\", \"dim\": \"文案破译能力\"}, {\"title\": \"看到一堆emoji爱心后面跟着“感恩遇见”“岁月静好”，我脑子里会自动翻译成“没啥可说的了”。\", \"dim\": \"文案破译能力\"}, {\"title\": \"如果纪念日小作文里全是网络流行情话，我会怀疑是不是复制粘贴的。\", \"dim\": \"文案破译能力\"}, {\"title\": \"在图书馆、健身房这种需要安静的地方拍亲密对视摆拍，我觉得戏有点过。\", \"dim\": \"场景违和感雷达\"}, {\"title\": \"一方精心打扮，另一方穿着拖鞋睡衣入镜的“居家甜蜜”照，我会觉得是临时抓拍。\", \"dim\": \"场景违和感雷达\"}, {\"title\": \"所有礼物照片都带着清晰商标和价签，像在搞产品发布会。\", \"dim\": \"场景违和感雷达\"}, {\"title\": \"我会顺手翻一下，TA今天秀的这束花，和三个月前吵架后道歉的那束，是不是同一家店。\", \"dim\": \"历史动态交叉比对能力\"}, {\"title\": \"如果一方突然开始频繁晒恩爱，我会去看另一方最近的动态是不是在emo。\", \"dim\": \"历史动态交叉比对能力\"}, {\"title\": \"官宣合照里戴的情侣对戒，在双方各自的单人照里从来没见过。\", \"dim\": \"历史动态交叉比对能力\"}, {\"title\": \"有时候没什么具体证据，但就是觉得这对“好得不太对劲”。\", \"dim\": \"直觉预警灵敏度\"}, {\"title\": \"看到过于“完美”、像营销号模板的爱情vlog，我的尴尬癌会先于我的羡慕心发作。\", \"dim\": \"直觉预警灵敏度\"}, {\"title\": \"如果一对从来不秀恩爱的朋友突然狂秀，我反而会有点担心。\", \"dim\": \"直觉预警灵敏度\"}, {\"title\": \"看破不说破，但会在心里默默给这段关系贴个“观察中”的标签。\", \"dim\": \"拆穿后的反应模式\"}, {\"title\": \"会跟信得过的朋友私下交换眼神，达成“懂的都懂”的共识。\", \"dim\": \"拆穿后的反应模式\"}, {\"title\": \"如果当事人跑来问我“你觉得我们怎么样”，我会选择委婉地夸照片拍得不错。\", \"dim\": \"拆穿后的反应模式\"}], \"resultTypes\": [{\"name\": \"人形测谎仪\", \"emoji\": \"🕵️‍♀️\", \"emojiBg\": \"#2D3047\", \"desc\": \"你的眼睛就是尺。嘴角肌肉的0.1秒僵硬、肢体距离的1厘米疏远，都逃不过你的法眼。你不是在刷朋友圈，你是在进行微表情分析。\", \"match\": \"微表情捕捉力\"}, {\"name\": \"文案解码专家\", \"emoji\": \"📜\", \"emojiBg\": \"#FF9F43\", \"desc\": \"“岁月静好”等于无话可说，“感恩遇见”可能是吵架刚和好。在你眼里，每一条甜蜜文案背后都藏着另一套需要破译的密码。\", \"match\": \"文案破译能力\"}, {\"name\": \"场景侦探\", \"emoji\": \"🎬\", \"emojiBg\": \"#6BC5A9\", \"desc\": \"摆拍痕迹过重、场景与情感严重不符、道具像是临时借来的……你总能一眼看出这场“恩爱戏”的导演在哪个环节偷了懒。\", \"match\": \"场景违和感雷达\"}, {\"name\": \"时间线警察\", \"emoji\": \"⏳\", \"emojiBg\": \"#A8D8EA\", \"desc\": \"你擅长把碎片拼回原图。通过交叉比对双方数月甚至数年的动态，你总能发现那些被精心编辑过的时间线里，藏着怎样的断裂与拼接。\", \"match\": \"历史动态交叉比对能力\"}, {\"name\": \"直觉预警机\", \"emoji\": \"🚨\", \"emojiBg\": \"#FF6B6B\", \"desc\": \"证据？有时候不需要证据。一种过于用力的甜蜜，一种完美到失真的和谐，就能让你的警报器嗡嗡作响。你的直觉，往往就是第一手证据。\", \"match\": \"直觉预警灵敏度\"}, {\"name\": \"沉默的观察者\", \"emoji\": \"🤐\", \"emojiBg\": \"#95A5A6\", \"desc\": \"看穿一切，但选择闭嘴。你深知“塑料”也有它存在的理由，可能是保温，可能是装饰。你的最高技能不是拆穿，而是在心里完成所有鉴定后，关上报告书。\", \"match\": \"拆穿后的反应模式\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"恋爱系统版本过低\", \"title\": \"你的恋爱系统，卡在哪个版本了？\", \"dims\": [\"运行内存\", \"处理器速度\", \"信号接收\", \"系统UI\", \"兼容性\", \"续航能力\"], \"qs\": [{\"title\": \"我经常觉得，恋爱这件事太占脑子了，处理不来。\", \"dim\": \"运行内存\"}, {\"title\": \"对方发来一长段话，我第一反应是“等会儿再看”，然后就忘了。\", \"dim\": \"运行内存\"}, {\"title\": \"同时处理“对方情绪”和“自己工作”，我大概率会死机。\", \"dim\": \"运行内存\"}, {\"title\": \"对方抛出一个暧昧信号，我可能要过好几天才反应过来。\", \"dim\": \"处理器速度\"}, {\"title\": \"吵架时，我脑子里想好反驳的话，嘴跟不上。\", \"dim\": \"处理器速度\"}, {\"title\": \"别人都开始谈婚论嫁了，我还在加载“喜欢一个人是什么感觉”这个基础程序。\", \"dim\": \"处理器速度\"}, {\"title\": \"对方暗示“今晚月色真美”，我大概率会回“嗯，风也挺大”。\", \"dim\": \"信号接收\"}, {\"title\": \"我觉得“在干嘛”就是字面意思，不是在找话题。\", \"dim\": \"信号接收\"}, {\"title\": \"对方生气了，我通常要等对方明说“我生气了”才能确认。\", \"dim\": \"信号接收\"}, {\"title\": \"我的恋爱聊天记录里，表情包比情话多十倍。\", \"dim\": \"系统UI\"}, {\"title\": \"约会项目，我的首选永远是吃饭看电影，想不出新花样。\", \"dim\": \"系统UI\"}, {\"title\": \"说“我想你”对我来说，比做一份PPT还难。\", \"dim\": \"系统UI\"}, {\"title\": \"我完全无法理解“作”和“撒娇”的区别。\", \"dim\": \"兼容性\"}, {\"title\": \"对方如果是个文艺青年，喜欢聊哲学电影，我会直接宕机。\", \"dim\": \"兼容性\"}, {\"title\": \"我觉得“恋爱就要天天黏在一起”这个设定，本身就有bug。\", \"dim\": \"兼容性\"}, {\"title\": \"连续聊微信超过半小时，我就想找个借口“手机没电了”。\", \"dim\": \"续航能力\"}, {\"title\": \"一场约会下来，我需要的恢复时间比约会本身还长。\", \"dim\": \"续航能力\"}, {\"title\": \"想到要维持一段长期关系，第一感觉是“耗电太快，撑不住”。\", \"dim\": \"续航能力\"}], \"resultTypes\": [{\"name\": \"小霸王学习机\", \"emoji\": \"🕹️\", \"emojiBg\": \"#FF9F43\", \"desc\": \"内存严重不足，只能运行基础程序。你的恋爱系统主打一个怀旧复古，处理复杂情感就像运行3D游戏——直接黑屏。简单点，恋爱的方式简单点。\", \"match\": \"运行内存\"}, {\"name\": \"拨号上网\", \"emoji\": \"📞\", \"emojiBg\": \"#C9C9C9\", \"desc\": \"处理信息的速度，慢到能听见“嘀嘀嘀”的拨号音。等你加载完对方上一句话的情绪，话题已经过去三个了。不是不想回，是网速不允许。\", \"match\": \"处理器速度\"}, {\"name\": \"信号格永远只有一格\", \"emoji\": \"📶\", \"emojiBg\": \"#A8D8EA\", \"desc\": \"接收恋爱信号的灵敏度极低，永远在“有信号吗？”和“好像又没了”之间徘徊。浪漫电波穿过你的大脑，就像穿过法拉第笼，基本被屏蔽。\", \"match\": \"信号接收\"}, {\"name\": \"Windows 98 经典主题\", \"emoji\": \"💻\", \"emojiBg\": \"#6C5CE7\", \"desc\": \"交互界面极其朴素且直男/直女。没有花里胡哨的皮肤和动画，表达爱意的方式像经典的蓝屏死机提示——直接，且让人不知所措。\", \"match\": \"系统UI\"}, {\"name\": \"专用充电接口\", \"emoji\": \"🔌\", \"emojiBg\": \"#FFD93D\", \"desc\": \"兼容性极差，只适配特定型号（比如，跟自己一模一样的人）。稍微有点个性的对象插进来，系统就提示“无法识别此设备”。\", \"match\": \"兼容性\"}, {\"name\": \"五号电池驱动\", \"emoji\": \"🔋\", \"emojiBg\": \"#FF6B6B\", \"desc\": \"恋爱续航极短，需要频繁更换“独处电池”才能维持待机。高强度社交互动半小时，电量直接告急，自动进入省电（勿扰）模式。\", \"match\": \"续航能力\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"恋爱躺平学家\", \"title\": \"你的恋爱被动等级是？\", \"dims\": [\"主动出击阈值\", \"信号接收灵敏度\", \"内心戏丰富度\", \"等待耐力\", \"缘分迷信指数\", \"自我合理化能力\"], \"qs\": [{\"title\": \"我总觉得主动发消息约人，有种莫名的羞耻感。\", \"dim\": \"主动出击阈值\"}, {\"title\": \"如果对方没主动找我，我宁愿自己刷手机刷到睡着。\", \"dim\": \"主动出击阈值\"}, {\"title\": \"让我先开口说“我喜欢你”，不如让我去跑个马拉松。\", \"dim\": \"主动出击阈值\"}, {\"title\": \"对方发个句号，我都能脑补出一部连续剧。\", \"dim\": \"信号接收灵敏度\"}, {\"title\": \"我经常觉得对方某个眼神或动作是在暗示我，但我不确定。\", \"dim\": \"信号接收灵敏度\"}, {\"title\": \"对方朋友圈发一首歌，我会立刻去查歌词含义。\", \"dim\": \"信号接收灵敏度\"}, {\"title\": \"在脑海里，我们已经从相识到结婚生子过完了一生。\", \"dim\": \"内心戏丰富度\"}, {\"title\": \"我经常在深夜复盘白天和TA说的每一句话，思考有没有说错。\", \"dim\": \"内心戏丰富度\"}, {\"title\": \"连孩子叫什么名字、以后上什么小学都想好了，但现实中还没加微信。\", \"dim\": \"内心戏丰富度\"}, {\"title\": \"我可以等一个人回消息等到手机自动锁屏。\", \"dim\": \"等待耐力\"}, {\"title\": \"我觉得“如果TA真的喜欢我，总会来找我的”。\", \"dim\": \"等待耐力\"}, {\"title\": \"一段关系没进展，我的第一反应是“再等等看”。\", \"dim\": \"等待耐力\"}, {\"title\": \"我相信“正缘”是躲不掉的，该来的总会来。\", \"dim\": \"缘分迷信指数\"}, {\"title\": \"刷到星座/塔罗说“近期有桃花”，我会当真并开始期待。\", \"dim\": \"缘分迷信指数\"}, {\"title\": \"我觉得恋爱主要靠运气，努力没用。\", \"dim\": \"缘分迷信指数\"}, {\"title\": \"对方没选我，我会安慰自己“是TA没眼光/没福气”。\", \"dim\": \"自我合理化能力\"}, {\"title\": \"单身久了，我觉得“一个人也挺好”不是嘴硬，是真心的。\", \"dim\": \"自我合理化能力\"}, {\"title\": \"看到别人秀恩爱，我的想法是“他们以后肯定会吵架”。\", \"dim\": \"自我合理化能力\"}], \"resultTypes\": [{\"name\": \"战略定投型\", \"emoji\": \"🎯\", \"emojiBg\": \"#4D96FF\", \"desc\": \"你的主动阈值高到离谱，坚信“好货沉底”，只等那个能一眼看穿你坚硬外壳下柔软内心的人出现。你的恋爱策略是长期持有，不追涨杀跌。\", \"match\": \"主动出击阈值\"}, {\"name\": \"信号放大器\", \"emoji\": \"📡\", \"emojiBg\": \"#6BC77B\", \"desc\": \"你拥有将任何微小互动解读为“TA可能喜欢我”的神奇能力。一个点赞等于告白，一次偶遇是命运安排。你的世界充满了未被证实的甜蜜信号。\", \"match\": \"信号接收灵敏度\"}, {\"name\": \"颅内导演\", \"emoji\": \"🎬\", \"emojiBg\": \"#FF6B9D\", \"desc\": \"现实中的对话可能不超过十句，但你脑内的爱情史诗已经拍到了第三季。你擅长用丰富的内心戏填补所有现实空白，自编自导自演，乐在其中。\", \"match\": \"内心戏丰富度\"}, {\"name\": \"静默守望者\", \"emoji\": \"⏳\", \"emojiBg\": \"#A8D8EA\", \"desc\": \"你的耐心深不可测，相信时间会给出所有答案。你能在一种模糊的、不确定的状态中待上很久，仿佛在玩一场谁先动谁就输了的游戏。\", \"match\": \"等待耐力\"}, {\"name\": \"玄学依赖症\", \"emoji\": \"🔮\", \"emojiBg\": \"#9D65C9\", \"desc\": \"你将个人幸福大量外包给命运、星座、塔罗和各类玄学。你的行动指南不是心，而是“水逆不宜表白”、“本周双子座桃花运旺”。\", \"match\": \"缘分迷信指数\"}, {\"name\": \"逻辑自洽大师\", \"emoji\": \"🧠\", \"emojiBg\": \"#FFD93D\", \"desc\": \"无论感情状况如何，你都能迅速构建一套无懈可击的逻辑来自我安慰。“单身是自由”、“不被爱是对方的问题”、“错过是福报”。你的心态永远稳如老狗。\", \"match\": \"自我合理化能力\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"前任纪念品博物馆\", \"title\": \"你的前任博物馆，几级馆藏？\", \"dims\": [\"藏品入库标准\", \"藏品分类体系\", \"展陈活跃度\", \"清理触发阈值\", \"馆藏价值认知\"], \"qs\": [{\"title\": \"我手机里还存着一些前任的照片，没删，但也不会特意去看。\", \"dim\": \"藏品入库标准\"}, {\"title\": \"收到过一些没什么用的小礼物，比如毛绒玩具，现在还在家里某个角落。\", \"dim\": \"藏品入库标准\"}, {\"title\": \"有些聊天记录截图，当时觉得有意义就存了，现在也懒得翻出来删。\", \"dim\": \"藏品入库标准\"}, {\"title\": \"我能清楚说出某件“纪念品”是哪次约会、因为什么事留下的。\", \"dim\": \"藏品分类体系\"}, {\"title\": \"有些东西，比如一件旧T恤，我会在心里把它归类为“实用类”而非“情感类”。\", \"dim\": \"藏品分类体系\"}, {\"title\": \"我甚至记得某些东西是“和平分手纪念”还是“吵架后补偿”。\", \"dim\": \"藏品分类体系\"}, {\"title\": \"刷到某些歌、电影或地点，会突然想起这是和前任一起经历过的。\", \"dim\": \"展陈活跃度\"}, {\"title\": \"和朋友聊天时，偶尔会提到“我前任以前也……”，然后自然地带过。\", \"dim\": \"展陈活跃度\"}, {\"title\": \"某些生活习惯或口头禅，仔细想想，好像是受前任影响留下的。\", \"dim\": \"展陈活跃度\"}, {\"title\": \"除非要搬家或者大扫除，否则我根本想不起来去处理那些旧物。\", \"dim\": \"清理触发阈值\"}, {\"title\": \"如果开始一段全新的、特别好的恋情，我可能会更有动力清理过去。\", \"dim\": \"清理触发阈值\"}, {\"title\": \"某天心情特别差或特别好，突然看什么都顺眼或都不顺眼时，可能会扔一波。\", \"dim\": \"清理触发阈值\"}, {\"title\": \"我觉得留着某些东西，不代表我还留恋那个人，只是留恋那段时光里的自己。\", \"dim\": \"馆藏价值认知\"}, {\"title\": \"有些东西虽然用不上了，但质量挺好/挺贵的，扔了觉得浪费。\", \"dim\": \"馆藏价值认知\"}, {\"title\": \"彻底删除或扔掉所有痕迹，感觉像是否定了一段真实存在过的经历。\", \"dim\": \"馆藏价值认知\"}], \"resultTypes\": [{\"name\": \"来者不拒型仓库\", \"emoji\": \"📦\", \"emojiBg\": \"#9B9B9B\", \"desc\": \"你的入库标准极其宽松，本着“万一以后有用呢”的原则，啥都往里收。博物馆更像一个堆放杂物的仓库，分类靠缘分，清理看天意。\", \"match\": \"藏品入库标准\"}, {\"name\": \"编目大师\", \"emoji\": \"🏷️\", \"emojiBg\": \"#6C5CE7\", \"desc\": \"你的大脑自带一套严密的分类学系统。每件藏品都有清晰的来源、属性和情感标签。你不是忘不掉，你只是记得太清楚。\", \"match\": \"藏品分类体系\"}, {\"name\": \"常设展览\", \"emoji\": \"🎭\", \"dim\": \"展陈活跃度\", \"desc\": \"你的“博物馆”并非尘封仓库，藏品会通过记忆、习惯、言谈等渠道，时不时在当下生活中“展出”。它们已融入你的背景板，成为你的一部分。\", \"match\": \"展陈活跃度\"}, {\"name\": \"被动清理者\", \"emoji\": \"🌀\", \"emojiBg\": \"#00CEC9\", \"desc\": \"你的清理动作严重依赖外部触发。搬家、新恋情、极端情绪……没有这些“东风”，你的博物馆就能一直维持原样，岁月静好，积灰到老。\", \"match\": \"清理触发阈值\"}, {\"name\": \"历史学家\", \"emoji\": \"📜\", \"emojiBg\": \"#D4A574\", \"desc\": \"在你看来，这些“纪念品”是个人生命史的证据。清理它们不是告别一个人，而是抹去一段历史。你选择保留，作为自我叙事的一部分。\", \"match\": \"馆藏价值认知\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"赖床十级学者\", \"title\": \"你的赖床功力有多深？\", \"dims\": [\"闹钟抗性\", \"回笼觉深度\", \"起床缓冲期\", \"被窝依赖度\", \"自我欺骗指数\"], \"qs\": [{\"title\": \"我的闹钟设置，主打一个层层递进，从“温柔唤醒”到“夺命连环催”。\", \"dim\": \"闹钟抗性\"}, {\"title\": \"关掉闹钟的瞬间，脑子里已经自动规划好了接下来十分钟的“回笼觉方案”。\", \"dim\": \"闹钟抗性\"}, {\"title\": \"听到闹钟响，第一反应不是起床，是伸手在枕头边精准盲按“稍后提醒”。\", \"dim\": \"闹钟抗性\"}, {\"title\": \"说好再睡五分钟，醒来发现已经过去了一个世纪。\", \"dim\": \"回笼觉深度\"}, {\"title\": \"回笼觉做的梦，情节比晚上睡的还要完整、还要精彩。\", \"dim\": \"回笼觉深度\"}, {\"title\": \"能在两次闹钟间隔的短短几分钟里，迅速进入深度睡眠。\", \"dim\": \"回笼觉深度\"}, {\"title\": \"从“决定起床”到“身体离开床铺”，中间需要漫长的心理建设和肢体预热。\", \"dim\": \"起床缓冲期\"}, {\"title\": \"我会先坐起来发呆五分钟，感受灵魂慢慢归位。\", \"dim\": \"起床缓冲期\"}, {\"title\": \"起床前必须把今天要穿的衣服在脑子里搭配三遍，才能开始行动。\", \"dim\": \"起床缓冲期\"}, {\"title\": \"冬天起床的难度，约等于让我离开一个恒温37度的天堂。\", \"dim\": \"被窝依赖度\"}, {\"title\": \"觉得被窝以外的地方，都是危险的“远方”。\", \"dim\": \"被窝依赖度\"}, {\"title\": \"哪怕尿急，也要在被窝里蜷到最后一刻，进行极限挑战。\", \"dim\": \"被窝依赖度\"}, {\"title\": \"经常告诉自己“眯一下就好”，然后彻底睡过头。\", \"dim\": \"自我欺骗指数\"}, {\"title\": \"相信“只要我闭上眼睛，时间就会停止”。\", \"dim\": \"自我欺骗指数\"}, {\"title\": \"会把手机放在必须下床才能关掉的地方，然后第二天继续放在枕头边。\", \"dim\": \"自我欺骗指数\"}], \"resultTypes\": [{\"name\": \"免疫体质\", \"emoji\": \"🛡️\", \"emojiBg\": \"#C9C9C9\", \"desc\": \"闹钟于你如同蚊蝇，响任它响，你自岿然不动。关掉第八个闹钟时，嘴角甚至带着一丝胜利的微笑。你的赖床，是一场精心策划的、对清晨秩序的无声反抗。\", \"match\": \"闹钟抗性\"}, {\"name\": \"时空穿梭者\", \"emoji\": \"⏳\", \"emojiBg\": \"#6C5CE7\", \"desc\": \"你的回笼觉不是睡眠，是短暂的时空跃迁。说好五分钟，实际两小时。在梦里完成了另一段完整的人生，醒来恍如隔世，并需要额外十分钟来确认自己身在何方、今夕何夕。\", \"match\": \"回笼觉深度\"}, {\"name\": \"慢动作大师\", \"emoji\": \"🐌\", \"emojiBg\": \"#A29BFE\", \"desc\": \"你的起床过程被分解成了无数个0.5倍速的慢动作。坐起、发呆、伸懒腰、思考人生……每一个步骤都充满了仪式感和拖延的智慧。别人是起床，你是在进行一场行为艺术。\", \"match\": \"起床缓冲期\"}, {\"name\": \"被窝原住民\", \"emoji\": \"🛌\", \"emojiBg\": \"#74B9FF\", \"desc\": \"你的灵魂有一半已经和被窝完成了共生。离开它，如同鱼儿离开水。你不是在赖床，你是在守护你与这个温暖小宇宙之间不可分割的联结。外界的一切召唤，都是对你们感情的考验。\", \"match\": \"被窝依赖度\"}, {\"name\": \"首席忽悠官\", \"emoji\": \"🤥\", \"emojiBg\": \"#FFD93D\", \"desc\": \"最擅长忽悠的人就是你自己。“再睡五分钟”“明天一定早睡”“把手机放远点”……这些誓言像早餐的露水一样，在每一个清晨的阳光里蒸发得无影无踪。你永远在制定计划，也永远在打破计划。\", \"match\": \"自我欺骗指数\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"外卖永远点同款\", \"title\": \"你的外卖忠诚度有多高？\", \"dims\": [\"尝新恐惧指数\", \"决策瘫痪时长\", \"踩雷创伤后遗症\", \"菜单熟悉度\", \"味觉记忆依赖度\", \"配送路径稳定性\"], \"qs\": [{\"title\": \"打开外卖软件，看到新店推荐，我的第一反应是“算了，还是吃那家吧”。\", \"dim\": \"尝新恐惧指数\"}, {\"title\": \"我宁愿连续吃一周黄焖鸡，也不愿花十分钟研究一家新店。\", \"dim\": \"尝新恐惧指数\"}, {\"title\": \"朋友安利了一家新店，我会先问“跟XX家比怎么样？”，而不是直接下单。\", \"dim\": \"尝新恐惧指数\"}, {\"title\": \"选外卖时，我能在“已点过”和“新店”之间来回滑动半小时，最后点了老样子。\", \"dim\": \"决策瘫痪时长\"}, {\"title\": \"我收藏夹里躺着一堆“看起来不错”的店，但下单时永远只点最上面那两家。\", \"dim\": \"决策瘫痪时长\"}, {\"title\": \"点餐时间超过五分钟，我就会开始焦虑，然后火速退回安全区。\", \"dim\": \"决策瘫痪时长\"}, {\"title\": \"因为一次难吃的外卖，我能把这家店拉黑一年，并且对所有同类店铺产生PTSD。\", \"dim\": \"踩雷创伤后遗症\"}, {\"title\": \"我宁愿吃一份80分的熟悉味道，也不愿冒险尝试一份可能40分的新奇玩意。\", \"dim\": \"踩雷创伤后遗症\"}, {\"title\": \"看到差评里有一条“味道奇怪”，我就再也不会点这家店了。\", \"dim\": \"踩雷创伤后遗症\"}, {\"title\": \"我能背出常点那家店的菜单，甚至知道第几个套餐配菜最多。\", \"dim\": \"菜单熟悉度\"}, {\"title\": \"点餐时不需要看图片，直接选“麻辣香锅（中辣，加宽粉，不要豆芽）”。\", \"dim\": \"菜单熟悉度\"}, {\"title\": \"老板要是换了配方，我吃第一口就能发现。\", \"dim\": \"菜单熟悉度\"}, {\"title\": \"我觉得“家的味道”不是妈妈做的菜，是公司楼下那家麻辣烫的味道。\", \"dim\": \"味觉记忆依赖度\"}, {\"title\": \"心情不好的时候，只有那家固定的外卖能带来一点确定性安慰。\", \"dim\": \"味觉记忆依赖度\"}, {\"title\": \"出差或旅游，最想念的不是家乡菜，而是自己常点的那口外卖。\", \"dim\": \"味觉记忆依赖度\"}, {\"title\": \"外卖小哥都认识我了，有时会直接问“老样子？”。\", \"dim\": \"配送路径稳定性\"}, {\"title\": \"我甚至能预测外卖大概几点送到，误差不超过五分钟。\", \"dim\": \"配送路径稳定性\"}, {\"title\": \"如果常点的店休息了，我那天就像失去了生活锚点，不知道该吃什么。\", \"dim\": \"配送路径稳定性\"}], \"resultTypes\": [{\"name\": \"绝对安全区居民\", \"emoji\": \"🏠\", \"emojiBg\": \"#A8D8EA\", \"desc\": \"你的外卖地图只有一条固定航线。任何偏离航向的尝试都会引发你的深海恐惧。对你来说，“未知”等于“难吃”的概率是99%。\", \"match\": \"尝新恐惧指数\"}, {\"name\": \"选择困难晚期\", \"emoji\": \"🌀\", \"emojiBg\": \"#C9C9C9\", \"desc\": \"你不是不想尝试，你是被“万一不好吃怎么办”这个念头困在了选择的漩涡里。最后，疲惫的大脑会帮你自动选择最省力的那条老路。\", \"match\": \"决策瘫痪时长\"}, {\"name\": \"一级创伤后应激者\", \"emoji\": \"💥\", \"emojiBg\": \"#FF9F43\", \"desc\": \"一次糟糕的踩雷经历，足以让你对所有新店建立“防火长城”。你的外卖哲学是：宁可错杀一千，不可放过一个难吃的可能。\", \"match\": \"踩雷创伤后遗症\"}, {\"name\": \"人形点餐机\", \"emoji\": \"🤖\", \"emojiBg\": \"#6C5CE7\", \"desc\": \"你对常点店铺的熟悉程度，堪比店里的兼职员工。点餐流程已刻入肌肉记忆，闭着眼睛都能完成支付。效率极高，惊喜为零。\", \"match\": \"菜单熟悉度\"}, {\"name\": \"味觉锚定者\", \"emoji\": \"⚓\", \"emojiBg\": \"#00B894\", \"desc\": \"那几口固定的味道，是你动荡生活里为数不多的稳定坐标。吃的不是饭，是熟悉感带来的安全感。换一家，感觉今天都不完整了。\", \"match\": \"味觉记忆依赖度\"}, {\"name\": \"路径依赖之王\", \"emoji\": \"🛣️\", \"emojiBg\": \"#FDCB6E\", \"desc\": \"从你的地址到那家店的路线，已经被大数据和外卖小哥走成了光滑的康庄大道。你不仅是顾客，更是这条“外卖丝绸之路”的缔造者。\", \"match\": \"配送路径稳定性\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"外卖口味考古学家\", \"title\": \"你的外卖味觉档案有多厚？\", \"dims\": [\"数据库广度\", \"细节记忆精度\", \"版本更新追踪力\", \"口味偏好雷达\", \"踩雷预警系统\", \"点单决策速度\"], \"qs\": [{\"title\": \"我能说出公司楼下那家黄焖鸡，去年和今年的汤底咸淡变化。\", \"dim\": \"数据库广度\"}, {\"title\": \"朋友问“哪家麻辣烫不油”，我能立刻报出三家并附赠辣度排序。\", \"dim\": \"数据库广度\"}, {\"title\": \"新开的店，我吃一次就能判断它家招牌菜是偏咸口还是甜口。\", \"dim\": \"数据库广度\"}, {\"title\": \"我能记得某家酸菜鱼外卖，上周的鱼片比这周厚了大概0.5毫米。\", \"dim\": \"细节记忆精度\"}, {\"title\": \"我能分辨出同一家店，午市和晚市出品的宫保鸡丁，花生脆度有微妙差别。\", \"dim\": \"细节记忆精度\"}, {\"title\": \"我能回忆起三个月前点的那份炸鸡，是左边更脆还是右边更脆。\", \"dim\": \"细节记忆精度\"}, {\"title\": \"我发现常点的那家米粉店，最近把酸豆角换成了萝卜干，并且立刻尝出来了。\", \"dim\": \"版本更新追踪力\"}, {\"title\": \"我会注意到常点的沙拉店，这周鸡胸肉腌料里好像多了一味黑胡椒。\", \"dim\": \"版本更新追踪力\"}, {\"title\": \"如果外卖包装换了，我第一反应是“味道是不是也微调了”。\", \"dim\": \"版本更新追踪力\"}, {\"title\": \"光是看菜单图片，我就能大致猜出这家店整体是偏咸还是偏淡。\", \"dim\": \"口味偏好雷达\"}, {\"title\": \"我能精准避开所有“图片看着辣，实际甜滋滋”的诈骗型外卖。\", \"dim\": \"口味偏好雷达\"}, {\"title\": \"给不吃香菜的朋友推荐外卖，我能自动过滤所有可能隐藏香菜的菜。\", \"dim\": \"口味偏好雷达\"}, {\"title\": \"看到“今日特价”但没吃过的店，我的第一反应是先去翻差评看口味吐槽。\", \"dim\": \"踩雷预警系统\"}, {\"title\": \"如果一家店突然换了主厨，我点单时会做好“这不是我认识的那个味道”的心理准备。\", \"dim\": \"踩雷预警系统\"}, {\"title\": \"我有一套自己的“备用店”清单，专门应对常点那家突然发挥失常。\", \"dim\": \"踩雷预警系统\"}, {\"title\": \"中午12点，我能在30秒内从收藏夹里锁定今天想吃的那一口。\", \"dim\": \"点单决策速度\"}, {\"title\": \"纠结吃啥时，我靠的不是“随便”，而是大脑里快速闪回各家招牌菜的口感。\", \"dim\": \"点单决策速度\"}, {\"title\": \"即使有满减红包，我也很少为优惠去冒险尝试完全陌生的店。\", \"dim\": \"点单决策速度\"}], \"resultTypes\": [{\"name\": \"活体点餐百科\", \"emoji\": \"📚\", \"emojiBg\": \"#6BC5D2\", \"desc\": \"你的大脑就是方圆三公里的外卖云端数据库。朋友点餐前都得先问你，你说“这家不行”，没人敢下单。\", \"match\": \"数据库广度\"}, {\"name\": \"米其林舌头（外卖版）\", \"emoji\": \"👅\", \"emojiBg\": \"#FF6B8B\", \"desc\": \"你能吃出厨师今天手抖多撒了一撮盐，能分辨出用的是预制菜包还是现炒锅气。你的评价，比商家回复还准。\", \"match\": \"细节记忆精度\"}, {\"name\": \"版本号监控者\", \"emoji\": \"🔍\", \"emojiBg\": \"#A78BFA\", \"desc\": \"你不仅吃味道，还吃版本迭代。商家任何微小的配方调整都逃不过你的嘴，是第一批发现“味道变了”的警报器。\", \"match\": \"版本更新追踪力\"}, {\"name\": \"人形口味探测器\", \"emoji\": \"📡\", \"emojiBg\": \"#4ECDC4\", \"desc\": \"你对咸、甜、辣、油有着雷达般的直觉。扫一眼菜品图，就能预判整家店的味型走向，精准匹配自己或他人的舌头。\", \"match\": \"口味偏好雷达\"}, {\"name\": \"排雷先锋\", \"emoji\": \"⚠️\", \"emojiBg\": \"#FFD93D\", \"desc\": \"你的点餐史，是一部精心撰写的《避坑指南》。你靠敏锐的嗅觉（和翻差评的手速）成功避开了99%的难吃外卖。\", \"match\": \"踩雷预警系统\"}, {\"name\": \"决策快枪手\", \"emoji\": \"⚡\", \"emojiBg\": \"#FF9F43\", \"desc\": \"在别人还在“吃啥”宇宙中迷茫时，你已完成了从馋虫召唤到下单支付的全流程。你的选择，又快又准，几乎从不失手。\", \"match\": \"点单决策速度\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"下辈子当外卖试吃员\", \"title\": \"你这辈子，为下辈子攒了多少试吃经验？\", \"dims\": [\"数据库广度\", \"味觉雷达灵敏度\", \"踩雷抗性\", \"点单决策树复杂度\", \"剩菜处理模式\", \"平台忠诚度\"], \"qs\": [{\"title\": \"我手机里至少有三个外卖App，并且都开过会员。\", \"dim\": \"数据库广度\"}, {\"title\": \"我能说出方圆五公里内，哪家黄焖鸡的土豆最烂，哪家的米饭最硬。\", \"dim\": \"数据库广度\"}, {\"title\": \"朋友让我推荐外卖，我能根据他的预算、口味、甚至当时饿不饿，给出三个不同选项。\", \"dim\": \"数据库广度\"}, {\"title\": \"光看商家列表里的菜品图，我就能大概判断出这家店是“实物与图片严重不符”还是“勉强能信”。\", \"dim\": \"味觉雷达灵敏度\"}, {\"title\": \"吃第一口，我就能分辨出这肉是新鲜的还是冷冻了很久的。\", \"dim\": \"味觉雷达灵敏度\"}, {\"title\": \"我能吃出这家店今天是不是换了个手生的厨师炒菜。\", \"dim\": \"味觉雷达灵敏度\"}, {\"title\": \"吃到明显不好吃的外卖，我通常会默默吃完，懒得给差评。\", \"dim\": \"踩雷抗性\"}, {\"title\": \"我已经对“图片仅供参考”这句话彻底麻木了。\", \"dim\": \"踩雷抗性\"}, {\"title\": \"就算连续踩雷三天，我第四天还是会打开外卖软件。\", \"dim\": \"踩雷抗性\"}, {\"title\": \"点外卖前，我会同时打开评价、销量、人均、距离、满减、红包六个维度进行交叉比对。\", \"dim\": \"点单决策树复杂度\"}, {\"title\": \"为了凑满减，我经常点一些本来不想吃的东西。\", \"dim\": \"点单决策树复杂度\"}, {\"title\": \"我会因为某家店包装好、送得快，而原谅它味道上的小瑕疵。\", \"dim\": \"点单决策树复杂度\"}, {\"title\": \"难吃的外卖，我会剩很多，但好吃的外卖，我会连汤汁都拌饭吃完。\", \"dim\": \"剩菜处理模式\"}, {\"title\": \"冰箱里经常有上次点多了没吃完、但已经不想再热的外卖。\", \"dim\": \"剩菜处理模式\"}, {\"title\": \"我会把觉得还行的剩菜，留到半夜饿的时候当宵夜。\", \"dim\": \"剩菜处理模式\"}, {\"title\": \"我有固定的“保底店铺”，不知道吃什么的时候就会点它，虽然已经吃腻了。\", \"dim\": \"平台忠诚度\"}, {\"title\": \"哪个平台给我发大额红包，我这几天就用哪个。\", \"dim\": \"平台忠诚度\"}, {\"title\": \"我清楚地记得每个外卖App会员日的折扣规则。\", \"dim\": \"平台忠诚度\"}], \"resultTypes\": [{\"name\": \"人形大众点评\", \"emoji\": \"🗺️\", \"emojiBg\": \"#74B9FF\", \"desc\": \"你的数据库庞大且分类清晰，是朋友眼中的“活地图”。下辈子可以直接上岗做区域督导，闭着眼睛都能画出美食热力图。\", \"match\": \"数据库广度\"}, {\"name\": \"黄金舌头\", \"emoji\": \"👅\", \"emojiBg\": \"#FF9F43\", \"desc\": \"你的味觉像装了精密传感器，科技与狠活、火候差一秒都逃不过你的审判。下辈子是盲测环节的王牌，一句“这肉腌过头了”能让后厨瑟瑟发抖。\", \"match\": \"味觉雷达灵敏度\"}, {\"name\": \"钢铁胃袋\", \"emoji\": \"🛡️\", \"emojiBg\": \"#636E72\", \"desc\": \"酸甜苦辣咸，雷品千千万，你的消化系统早已百毒不侵。下辈子适合试吃那些“概念超前”或“口味诡异”的新品，表情都不会变一下。\", \"match\": \"踩雷抗性\"}, {\"name\": \"算法成精\", \"emoji\": \"🧮\", \"emojiBg\": \"#A29BFE\", \"desc\": \"你的点单过程堪比运行一个复杂的优化算法，在口味、预算、时间、优惠间找到完美平衡。下辈子可以直接去平台总部优化推荐系统。\", \"match\": \"点单决策树复杂度\"}, {\"name\": \"光盘行动派\", \"emoji\": \"🍽️\", \"emojiBg\": \"#55EFC4\", \"desc\": \"你对食物有极强的责任感，好吃绝不浪费，难吃也尽量消化。下辈子是“杜绝餐饮浪费”宣传大使，试吃份量拿捏得刚刚好。\", \"match\": \"剩菜处理模式\"}, {\"name\": \"游牧型食客\", \"emoji\": \"🏕️\", \"emojiBg\": \"#FDCB6E\", \"desc\": \"你没有固定的平台信仰，永远追逐着红包和优惠的绿洲。下辈子适合做跨平台比价员，专门寻找隐藏的优惠漏洞和神券。\", \"match\": \"平台忠诚度\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"外卖满减计算器\", \"title\": \"你的满减算力有多强？\", \"dims\": [\"凑单精度\", \"价格敏感度\", \"时间成本容忍度\", \"组合灵活性\", \"后悔阈值\", \"规则解读力\"], \"qs\": [{\"title\": \"我为了凑满减，会加一份根本不想吃的薯条。\", \"dim\": \"凑单精度\"}, {\"title\": \"结算前发现差两毛钱，我会把购物车翻个底朝天找补。\", \"dim\": \"凑单精度\"}, {\"title\": \"我能精准算出“满30减15”和“满50减25”哪个折扣更大。\", \"dim\": \"凑单精度\"}, {\"title\": \"配送费超过5块，我宁愿换一家店。\", \"dim\": \"价格敏感度\"}, {\"title\": \"看到“原价35，现价29.9”这种把戏，我会立刻关掉页面。\", \"dim\": \"价格敏感度\"}, {\"title\": \"我清楚地记得常点几家店的起送价和满减门槛。\", \"dim\": \"价格敏感度\"}, {\"title\": \"为了省5块钱，我愿意花20分钟研究优惠券。\", \"dim\": \"时间成本容忍度\"}, {\"title\": \"我会同时打开三个外卖App比价。\", \"dim\": \"时间成本容忍度\"}, {\"title\": \"饿到不行的时候，我才会放弃凑单直接下单。\", \"dim\": \"时间成本容忍度\"}, {\"title\": \"我能接受用一份甜品或饮料来凑单，哪怕主食已经够了。\", \"dim\": \"组合灵活性\"}, {\"title\": \"如果凑不到完美的满减，我会考虑换一家店从头开始选。\", \"dim\": \"组合灵活性\"}, {\"title\": \"我会把想吃的留到下次，先用便宜的小菜把金额凑够。\", \"dim\": \"组合灵活性\"}, {\"title\": \"下单后发现忘了用红包，我会懊恼一整天。\", \"dim\": \"后悔阈值\"}, {\"title\": \"吃完才发现有更优的凑单方案，感觉这顿饭都不香了。\", \"dim\": \"后悔阈值\"}, {\"title\": \"如果朋友说我“为了省这点钱至于吗”，我会有点受伤。\", \"dim\": \"后悔阈值\"}, {\"title\": \"我能一眼看穿“限时秒杀”和“膨胀红包”是不是真划算。\", \"dim\": \"规则解读力\"}, {\"title\": \"我知道“会员红包”和“店铺红包”能不能叠加使用。\", \"dim\": \"规则解读力\"}, {\"title\": \"我会仔细阅读优惠券那一行小字里的使用规则。\", \"dim\": \"规则解读力\"}], \"resultTypes\": [{\"name\": \"人形计算器\", \"emoji\": \"🧮\", \"emojiBg\": \"#4ECDC4\", \"desc\": \"精度拉满，心算王者。你的大脑就是最优解算法，能在三秒内给出最省钱的方案，误差控制在分毫之间。朋友点外卖前都想先问问你。\", \"match\": \"凑单精度\"}, {\"name\": \"价格雷达\", \"emoji\": \"📡\", \"emojiBg\": \"#FF6B6B\", \"desc\": \"对数字极度敏感，任何溢价和套路都逃不过你的眼睛。在你这里，没有“差不多”，只有“值不值”。每一分钱都要花在刀刃上。\", \"match\": \"价格敏感度\"}, {\"name\": \"时间富豪\", \"emoji\": \"⏳\", \"emojiBg\": \"#95E1D3\", \"desc\": \"你的时间不值钱（不是）。愿意为了一点优惠投入大量时间，享受的是计算和博弈的过程本身。省钱是结果，折腾是乐趣。\", \"match\": \"时间成本容忍度\"}, {\"name\": \"凑单魔术师\", \"emoji\": \"🎩\", \"emojiBg\": \"#A8D8EA\", \"desc\": \"思路灵活，总能从意想不到的角度凑出完美方案。主食配饮料，正餐搭零食，在你手里没有不能组合的商品，只有还没发现的优惠路径。\", \"match\": \"组合灵活性\"}, {\"name\": \"完美主义强迫症\", \"emoji\": \"🎯\", \"emojiBg\": \"#FFD93D\", \"desc\": \"无法接受任何“本可以更省”的失误。一次不完美的下单能让你复盘好久，追求的是100%的优惠利用率和零遗憾的消费体验。\", \"match\": \"后悔阈值\"}, {\"name\": \"规则破解者\", \"emoji\": \"🔍\", \"emojiBg\": \"#6A67CE\", \"desc\": \"擅长解读和利用平台规则。红包叠加、限时门槛、隐藏优惠……在你眼里都不是障碍，而是可以组合排列的工具，总能找到系统的漏洞为自己谋利。\", \"match\": \"规则解读力\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"外卖差评鉴赏家\", \"title\": \"你靠差评活命吗？\", \"dims\": [\"差评依赖度\", \"差评鉴别力\", \"差评想象力\", \"差评行动力\", \"差评抗性\"], \"qs\": [{\"title\": \"我点外卖前，必须把差评区翻完才敢下单。\", \"dim\": \"差评依赖度\"}, {\"title\": \"如果一家店全是好评，我反而觉得是刷的，不敢点。\", \"dim\": \"差评依赖度\"}, {\"title\": \"我手机里存着几家店的“经典差评”截图，用来劝退朋友。\", \"dim\": \"差评依赖度\"}, {\"title\": \"我能从“肉有点柴”这种模糊差评里，判断出是肉不新鲜还是厨师手艺不行。\", \"dim\": \"差评鉴别力\"}, {\"title\": \"看到“送餐慢”，我会先看时间，是饭点高峰还是店家自己拖沓。\", \"dim\": \"差评鉴别力\"}, {\"title\": \"如果差评都在骂服务态度，但夸味道，这家店我大概率会试。\", \"dim\": \"差评鉴别力\"}, {\"title\": \"看到“包装漏了”，我脑子里能自动生成汤洒了一袋子的完整画面。\", \"dim\": \"差评想象力\"}, {\"title\": \"读“吃出头发”的差评，我会下意识地摸摸自己的头。\", \"dim\": \"差评想象力\"}, {\"title\": \"看到有人说“分量少”，我立刻就能想象出那个寒酸的外卖盒。\", \"dim\": \"差评想象力\"}, {\"title\": \"我不仅看差评，还会特意点开那些给差评的人的历史评价，看他们是不是专业差评师。\", \"dim\": \"差评行动力\"}, {\"title\": \"发现一家新店，我会先搜它其他平台有没有差评黑历史。\", \"dim\": \"差评行动力\"}, {\"title\": \"朋友问我哪家好吃，我第一反应是告诉他哪家差评最致命。\", \"dim\": \"差评行动力\"}, {\"title\": \"就算看到一条“有虫子”的恐怖差评，如果其他差评都很正常，我可能会觉得是偶然事件。\", \"dim\": \"差评抗性\"}, {\"title\": \"有些差评写得过于情绪化（全是感叹号），我反而会忽略。\", \"dim\": \"差评抗性\"}, {\"title\": \"如果一家店差评里都在说同一个问题（比如“太咸”），那我点的时候就会备注“少盐”。\", \"dim\": \"差评抗性\"}], \"resultTypes\": [{\"name\": \"差评原教旨主义者\", \"emoji\": \"📜\", \"emojiBg\": \"#8B7355\", \"desc\": \"差评是你的圣经，无差评不下单。你看差评不是为了避雷，是为了获得一种“我早已看穿一切”的优越感。朋友点外卖前都得经过你的差评审核。\", \"match\": \"差评依赖度\"}, {\"name\": \"刑侦级鉴差师\", \"emoji\": \"🔍\", \"emojiBg\": \"#4A90E2\", \"desc\": \"你能从“味道一般”里品出食材不新鲜，从“送得慢”里推断出店家出餐流程有问题。你看差评像法医看报告，每一句都是线索，最终拼出这家店的真实面目。\", \"match\": \"差评鉴别力\