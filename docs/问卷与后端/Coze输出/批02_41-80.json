"{\"questionnaire\": null, \"questionnaires\": [{\"prompt_version\": \"2.0\", \"tag\": \"确诊为WiFi信号\", \"title\": \"你的信号格还剩几格？\", \"dims\": [\"信号覆盖范围\", \"连接稳定性\", \"并发处理能力\", \"关键节点掉线率\", \"信号恢复速度\", \"环境抗干扰性\"], \"qs\": [{\"title\": \"我的社交圈就固定那几个人，很少主动拓展新朋友。\", \"dim\": \"信号覆盖范围\"}, {\"title\": \"超过三个人的局，我就开始觉得边缘，插不上话。\", \"dim\": \"信号覆盖范围\"}, {\"title\": \"别人聊的热门话题，我经常是最后一个知道的。\", \"dim\": \"信号覆盖范围\"}, {\"title\": \"和人聊天，经常聊着聊着就不知道回什么了，对话就断了。\", \"dim\": \"连接稳定性\"}, {\"title\": \"线上聊天，我经常是那个最后回复或者干脆不回了的人。\", \"dim\": \"连接稳定性\"}, {\"title\": \"约好的事，临到跟前我可能会突然不想去了。\", \"dim\": \"连接稳定性\"}, {\"title\": \"微信消息一多，我就想全部设为未读，等“有空”再回。\", \"dim\": \"并发处理能力\"}, {\"title\": \"同时处理多件事，我的脑子会像电脑一样卡死。\", \"dim\": \"并发处理能力\"}, {\"title\": \"饭局上超过五个人，我的注意力就开始分散，听不清谁在说什么。\", \"dim\": \"并发处理能力\"}, {\"title\": \"每次要做重要汇报或面试，前一晚准失眠。\", \"dim\": \"关键节点掉线率\"}, {\"title\": \"越是想在喜欢的人面前表现好，越是容易说错话办砸事。\", \"dim\": \"关键节点掉线率\"}, {\"title\": \"deadline越近，我越容易刷起无关紧要的视频，就是不想开工。\", \"dim\": \"关键节点掉线率\"}, {\"title\": \"和人吵完架，我能自己闷气闷一整天。\", \"dim\": \"信号恢复速度\"}, {\"title\": \"搞砸一件事后，我需要很久才能重新进入状态。\", \"dim\": \"信号恢复速度\"}, {\"title\": \"周末彻底躺平后，周一早上重启上班模式异常困难。\", \"dim\": \"信号恢复速度\"}, {\"title\": \"在嘈杂的办公室或咖啡馆，我很难集中精力工作。\", \"dim\": \"环境抗干扰性\"}, {\"title\": \"身边有人不停说话或打电话，我会非常烦躁，完全没法思考。\", \"dim\": \"环境抗干扰性\"}, {\"title\": \"计划被打乱，哪怕是很小的变动，我也会感到焦虑。\", \"dim\": \"环境抗干扰性\"}], \"resultTypes\": [{\"name\": \"满格信号\", \"emoji\": \"📶\", \"emojiBg\": \"#4CD964\", \"desc\": \"覆盖广，连接稳，人多也不慌。你是社交场合的强力路由器，走哪都是C位信号塔。\", \"match\": \"信号覆盖范围\"}, {\"name\": \"间歇性断连\", \"emoji\": \"📡\", \"emojiBg\": \"#FF9500\", \"desc\": \"信号时有时无，聊得好好的突然就“加载中…”。别人以为你高冷，其实你只是信号不稳。\", \"match\": \"连接稳定性\"}, {\"name\": \"单线程处理器\", \"emoji\": \"💻\", \"emojiBg\": \"#5AC8FA\", \"desc\": \"一次只能处理一个连接，消息一多就过载卡顿。不是不想回，是CPU真的烧了。\", \"match\": \"并发处理能力\"}, {\"name\": \"关键时刻掉链子\", \"emoji\": \"🔌\", \"emojiBg\": \"#FF3B30\", \"desc\": \"平时还行，一到重要场合准掉线。演讲忘词、面试宕机，你的“关键时刻debuff”已叠满。\", \"match\": \"关键节点掉线率\"}, {\"name\": \"缓慢重连\", \"emoji\": \"🐌\", \"emojiBg\": \"#AF52DE\", \"desc\": \"崩了之后需要漫长重启。从emo中恢复，从摆烂中起身，你的缓冲进度条总是特别长。\", \"match\": \"信号恢复速度\"}, {\"name\": \"易受干扰体质\", \"emoji\": \"🌀\", \"emojiBg\": \"#5856D6\", \"desc\": \"对环境变化极度敏感，一点风吹草动就信号紊乱。需要绝对的安静才能维持稳定输出。\", \"match\": \"环境抗干扰性\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"友谊的小船是什么材质\", \"title\": \"测测你的友谊是什么做的\", \"dims\": [\"船体坚固度\", \"防水密封性\", \"载重上限\", \"翻船后修复力\", \"抗风浪稳定性\", \"航行续航力\"], \"qs\": [{\"title\": \"朋友借钱不还，我最多能忍到第三次开口。\", \"dim\": \"船体坚固度\"}, {\"title\": \"朋友在背后说我坏话被我知道，这船基本就沉了。\", \"dim\": \"船体坚固度\"}, {\"title\": \"我觉得朋友之间，有些原则性问题一次都不能犯。\", \"dim\": \"船体坚固度\"}, {\"title\": \"我跟朋友吵完架，过几天还能像没事人一样约饭。\", \"dim\": \"防水密封性\"}, {\"title\": \"朋友无意中说了伤人的话，我会自己消化，不会让水漫进来。\", \"dim\": \"防水密封性\"}, {\"title\": \"我觉得朋友之间的小摩擦，就像船进了点水，舀出去就行。\", \"dim\": \"防水密封性\"}, {\"title\": \"朋友半夜emo打电话来，我能聊到ta睡着。\", \"dim\": \"载重上限\"}, {\"title\": \"朋友失恋连续找我哭诉一周，我有点扛不住了。\", \"dim\": \"载重上限\"}, {\"title\": \"我可以同时当好几个朋友的“情绪垃圾桶”。\", \"dim\": \"载重上限\"}, {\"title\": \"跟朋友绝交后，如果ta主动来和好，我大概率会接受。\", \"dim\": \"翻船后修复力\"}, {\"title\": \"我觉得真正的好朋友，就算船翻了，也能捞起来重修。\", \"dim\": \"翻船后修复力\"}, {\"title\": \"有过和朋友闹掰后，又和好如初的经历。\", \"dim\": \"翻船后修复力\"}, {\"title\": \"朋友因为别人说我坏话而疏远我，这种船不要也罢。\", \"dim\": \"抗风浪稳定性\"}, {\"title\": \"朋友谈恋爱后就消失，等ta分手又回来找我，我能理解。\", \"dim\": \"抗风浪稳定性\"}, {\"title\": \"我觉得友谊经不起第三方（对象、新朋友）的长期考验。\", \"dim\": \"抗风浪稳定性\"}, {\"title\": \"和小学/初中最好的朋友，现在还有联系。\", \"dim\": \"航行续航力\"}, {\"title\": \"我觉得朋友是分阶段的，过了那个阶段自然就淡了。\", \"dim\": \"航行续航力\"}, {\"title\": \"我能接受和朋友变成“点赞之交”，这不算船沉了。\", \"dim\": \"航行续航力\"}], \"resultTypes\": [{\"name\": \"铁甲舰\", \"emoji\": \"⚓\", \"emojiBg\": \"#6C7B8B\", \"desc\": \"你的友谊小船是铁打的。原则分明，底线坚硬，能抵御大多数风浪。一旦认定，极其稳固，但如果不幸触礁，修复起来也相当费劲。\", \"match\": \"船体坚固度\"}, {\"name\": \"永不沉没\", \"emoji\": \"🛡️\", \"emojiBg\": \"#4A90E2\", \"desc\": \"你的友谊密封性绝佳。小摩擦、小误会就像溅上来的水花，根本进不了船舱。擅长消化情绪，吵架不过夜，船体自带排水功能。\", \"match\": \"防水密封性\"}, {\"name\": \"超级货轮\", \"emoji\": \"🚢\", \"emojiBg\": \"#34495E\", \"desc\": \"你的友谊小船载重量惊人。你是朋友心中可靠的“承重墙”，善于接纳和承载他人的情绪与麻烦。但小心别超载，给自己也留点空间。\", \"match\": \"载重上限\"}, {\"name\": \"橡皮艇\", \"emoji\": \"🛶\", \"emojiBg\": \"#E74C3C\", \"desc\": \"你的友谊小船翻覆风险高，但修复能力极强。容易因为一些事倾覆，但气放完了又能吹起来。关系弹性大，不记隔夜仇，主打一个“散了再聚”。\", \"match\": \"翻船后修复力\"}, {\"name\": \"摇摆小舟\", \"emoji\": \"🚤\", \"emojiBg\": \"#3498DB\", \"desc\": \"你的友谊小船抗干扰能力一般。容易受外界风浪（如第三方关系、闲言碎语）影响而剧烈摇晃。关系好坏，很大程度上取决于有没有“暴风雨”。\", \"match\": \"抗风浪稳定性\"}, {\"name\": \"远洋邮轮\", \"emoji\": \"🛳️\", \"emojiBg\": \"#2C3E50\", \"desc\": \"你的友谊小船续航力持久。能够跨越时间和距离的考验，不因阶段变化而轻易断联。擅长将亲密关系转化为另一种更长久、更平缓的模式。\", \"match\": \"航行续航力\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"职场人设崩塌现场\", \"title\": \"你的职场人设，离崩还有多远？\", \"dims\": [\"人设维护成本\", \"崩塌触发灵敏度\", \"手滑事故频率\", \"现场修复能力\", \"人设与真我温差\", \"社死记忆时长\"], \"qs\": [{\"title\": \"我发工作消息前，会反复检查措辞和表情，生怕语气不对。\", \"dim\": \"人设维护成本\"}, {\"title\": \"为了显得专业，我连午休听的歌单都要切到“深度思考专用”。\", \"dim\": \"人设维护成本\"}, {\"title\": \"同事随口一句“你今天怎么有点不一样”，我能脑补一整天是不是人设有裂缝。\", \"dim\": \"人设维护成本\"}, {\"title\": \"发错群的消息哪怕秒撤，我也会觉得全世界都看到了。\", \"dim\": \"崩塌触发灵敏度\"}, {\"title\": \"老板路过我工位时我刚好在摸鱼，那一瞬间我觉得自己职业生涯要结束了。\", \"dim\": \"崩塌触发灵敏度\"}, {\"title\": \"视频会议不小心开了摄像头，哪怕只有一秒，我也觉得形象全毁了。\", \"dim\": \"崩塌触发灵敏度\"}, {\"title\": \"我干过把吐槽甲方的消息发到甲方群这种事。\", \"dim\": \"手滑事故频率\"}, {\"title\": \"撤回消息是我最常用的功能，比发送还熟练。\", \"dim\": \"手滑事故频率\"}, {\"title\": \"我经常在发完“好的收到”后，才发现自己根本没理解任务。\", \"dim\": \"手滑事故频率\"}, {\"title\": \"发错消息后，我能立刻编出一个合理的解释圆回来。\", \"dim\": \"现场修复能力\"}, {\"title\": \"就算人设崩了，我也能迅速切换成“真实不做作”的新人设。\", \"dim\": \"现场修复能力\"}, {\"title\": \"我会用自嘲化解尴尬，比如“看吧，这才是真实的我”。\", \"dim\": \"现场修复能力\"}, {\"title\": \"下班后疯玩的朋友圈，我会严格屏蔽所有同事。\", \"dim\": \"人设与真我温差\"}, {\"title\": \"我在同事面前是“早睡早起养生党”，实际天天熬夜冲浪。\", \"dim\": \"人设与真我温差\"}, {\"title\": \"团建时我唱的歌，和KTV里我真正的必点曲目，完全是两个世界的产物。\", \"dim\": \"人设与真我温差\"}, {\"title\": \"三年前某次开会说错话的尴尬，我现在想起来脚趾还能抠出三室一厅。\", \"dim\": \"社死记忆时长\"}, {\"title\": \"我觉得同事肯定都记得我那次人设崩塌的瞬间，只是假装忘了。\", \"dim\": \"社死记忆时长\"}, {\"title\": \"每次见到那位目睹过我“事故现场”的同事，我还是会有点不自在。\", \"dim\": \"社死记忆时长\"}], \"resultTypes\": [{\"name\": \"精装修样板间\", \"emoji\": \"🏢\", \"emojiBg\": \"#2ECC71\", \"desc\": \"你的人设维护成本极高，像一间永远保持完美的样板间。每一条消息都是精心打磨的文案，每一个表情都经过风险评估。活得有点累，但崩塌风险确实低——只要别停电。\", \"match\": \"人设维护成本\"}, {\"name\": \"玻璃心易碎品\", \"emoji\": \"💔\", \"emojiBg\": \"#FF6B6B\", \"desc\": \"你的崩塌触发灵敏度拉满了。一次手滑、一个错别字、甚至别人一个无意的眼神，都能让你觉得人设轰然倒塌。内心戏比工作汇报还长，主打一个随时随地准备社死。\", \"match\": \"崩塌触发灵敏度\"}, {\"name\": \"手滑惯犯\", \"emoji\": \"🤦\", \"emojiBg\": \"#FECA57\", \"desc\": \"你的手滑事故频率高得惊人。错群、错人、错文件是家常便饭，撤回键是你最亲密的战友。同事可能已经习惯了你的“节目效果”，但你每次依然会心跳骤停三秒。\", \"match\": \"手滑事故频率\"}, {\"name\": \"废墟重建大师\", \"emoji\": \"🏗️\", \"emojiBg\": \"#48DBFB\", \"desc\": \"你的现场修复能力堪称一绝。人设塌了？没关系，你能立刻在废墟上搭起一个更讨喜的帐篷。尴尬瞬间总能被你巧妙化解，甚至变成展现“幽默真实”的新机会。\", \"match\": \"现场修复能力\"}, {\"name\": \"冰火两重天\", \"emoji\": \"🌡️\", \"emojiBg\": \"#FF9FF3\", \"desc\": \"你的人设与真我之间存在巨大温差。上班是温顺靠谱的“恒温动物”，下班是放飞自我的“火山爆发”。切换之丝滑，仿佛拥有两套独立的神经系统。\", \"match\": \"人设与真我温差\"}, {\"name\": \"永恒社死记忆体\", \"emoji\": \"🧠\", \"emojiBg\": \"#A29BFE\", \"desc\": \"你的社死记忆时长是永久性的。每一次人设崩塌的细节都刻在DNA里，随时可能被某个相似场景触发，让你在深夜反复咀嚼那份尴尬。对你来说，互联网真的有记忆，而且就住在你脑子里。\", \"match\": \"社死记忆时长\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"你的专属BGM是什么\", \"title\": \"你的人生BGM是啥调调？\", \"dims\": [\"乐器适配度\", \"播放时机\", \"曲风稳定度\", \"音量大小\", \"循环模式\", \"他人收听体验\"], \"qs\": [{\"title\": \"我走路带风的时候，脑子里会自动响起一段旋律。\", \"dim\": \"乐器适配度\"}, {\"title\": \"遇到尴尬场面，我会觉得背景音该是二胡的《二泉映月》。\", \"dim\": \"乐器适配度\"}, {\"title\": \"我觉得唢呐一响，不是大喜就是大悲，特别适合我的情绪起伏。\", \"dim\": \"乐器适配度\"}, {\"title\": \"周一早上起床，我的BGM通常是哀乐前奏。\", \"dim\": \"播放时机\"}, {\"title\": \"我一紧张，脑子里就开始单曲循环《命运交响曲》的开头。\", \"dim\": \"播放时机\"}, {\"title\": \"干饭的时候，我的BGM会自动切换成《中华小当家》的插曲。\", \"dim\": \"播放时机\"}, {\"title\": \"我的情绪BGM很固定，开心就一首，emo就另一首，很少串台。\", \"dim\": \"曲风稳定度\"}, {\"title\": \"别人说我喜怒无常，BGM切换得像DJ打碟。\", \"dim\": \"曲风稳定度\"}, {\"title\": \"我能根据不同的社交场合，在心里切换不同的背景音乐。\", \"dim\": \"曲风稳定度\"}, {\"title\": \"我的内心戏很足，BGM声音大到感觉别人也能听见。\", \"dim\": \"音量大小\"}, {\"title\": \"我经常因为脑内BGM太响，而听不清别人说话。\", \"dim\": \"音量大小\"}, {\"title\": \"我的BGM通常是若有若无的底噪，只有安静时自己才能察觉。\", \"dim\": \"音量大小\"}, {\"title\": \"我会因为一句歌词或一段旋律，在脑子里单曲循环一整天。\", \"dim\": \"循环模式\"}, {\"title\": \"我的BGM是随机的，刷到什么短视频BGM就自动植入什么。\", \"dim\": \"循环模式\"}, {\"title\": \"我有一首专属的“战歌”，重要时刻一定会把它在心里播放。\", \"dim\": \"循环模式\"}, {\"title\": \"朋友说跟我待久了，能猜到我现在脑子里在放什么歌。\", \"dim\": \"他人收听体验\"}, {\"title\": \"我情绪低落时，朋友会觉得周围空气都安静了，像BGM停了。\", \"dim\": \"他人收听体验\"}, {\"title\": \"有人评价过我“戏多”，大概是因为我表情总跟着不存在的BGM走。\", \"dim\": \"他人收听体验\"}], \"resultTypes\": [{\"name\": \"二胡常驻户\", \"emoji\": \"🎻\", \"emojiBg\": \"#8B7355\", \"desc\": \"人生主打一个凄婉婉转，悲欢离合都是弦乐独奏。你的BGM里总有股淡淡的忧伤，像自带《二泉映月》循环播放。\", \"match\": \"乐器适配度\"}, {\"name\": \"定点播放器\", \"emoji\": \"⏰\", \"emojiBg\": \"#FF9F43\", \"desc\": \"你的BGM像闹钟，到点就响。周一哀乐，周五《好日子》，切换精准，从不迟到。生活被你过成了有预告片的连续剧。\", \"match\": \"播放时机\"}, {\"name\": \"单曲循环王\", \"emoji\": \"🔂\", \"emojiBg\": \"#6BCEFF\", \"desc\": \"一首歌能用一辈子。情绪稳定，BGM更稳定。你的世界像老式收音机，虽然频道少，但信号贼稳，听久了还挺上头。\", \"match\": \"曲风稳定度\"}, {\"name\": \"颅内交响乐团\", \"emoji\": \"🎧\", \"emojiBg\": \"#FF6B6B\", \"desc\": \"你的BGM是杜比全景声。内心戏波澜壮阔，配乐音量开到最大，仿佛全世界都是你的听众。其实，只有你自己听得最嗨。\", \"match\": \"音量大小\"}, {\"name\": \"洗脑循环体\", \"emoji\": \"🌀\", \"emojiBg\": \"#A29BFE\", \"desc\": \"被一段旋律绑架是常态。早上刷到的神曲，晚上睡觉前还在脑子里“再来一遍”。你的大脑不是CPU，是个复读机。\", \"match\": \"循环模式\"}, {\"name\": \"人形BGM播放器\", \"emoji\": \"📢\", \"emojiBg\": \"#FFD93D\", \"desc\": \"你的情绪和状态会外溢成“氛围音效”，身边人甚至能通过你的脸色猜出此刻是《忐忑》还是《今天是个好日子》。存在感极强。\", \"match\": \"他人收听体验\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"你的爱情像什么APP\", \"title\": \"你的爱情，是哪款APP？\", \"dims\": [\"启动稳定性\", \"加载速度\", \"匹配算法\", \"用户反馈机制\", \"耗电与发热\", \"后台驻留时长\"], \"qs\": [{\"title\": \"我的感情经常在关键时刻突然卡死，或者直接闪退。\", \"dim\": \"启动稳定性\"}, {\"title\": \"我觉得我的感情系统里，总有一些无法复现的、玄学般的bug。\", \"dim\": \"启动稳定性\"}, {\"title\": \"别人问起我的感情状态，我常觉得“这很难评，系统不太稳定”。\", \"dim\": \"启动稳定性\"}, {\"title\": \"我对一个人上头，往往需要漫长的“正在加载”过程。\", \"dim\": \"加载速度\"}, {\"title\": \"看到对方的消息，我的反应经常是转圈，而不是秒回。\", \"dim\": \"加载速度\"}, {\"title\": \"进入一段新关系前，我总觉得进度条走得太慢，等得心焦。\", \"dim\": \"加载速度