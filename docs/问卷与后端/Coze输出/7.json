"{\"questionnaire\": null, \"questionnaires\": [{\"prompt_version\": \"2.0\", \"tag\": \"猫掉毛量计算\", \"title\": \"你家猫掉的毛能织几件毛衣？\", \"dims\": [\"掉毛密度\", \"粘附力场\", \"清理难度\", \"季节性波动\", \"毛发存在感\", \"心理接受度\"], \"qs\": [{\"title\": \"黑衣服在我家是消耗品，穿一次就废。\", \"dim\": \"掉毛密度\"}, {\"title\": \"我家猫走过的地方，会留下一道肉眼可见的“毛路”。\", \"dim\": \"掉毛密度\"}, {\"title\": \"我怀疑我家猫掉的毛，比它本身体积还大。\", \"dim\": \"掉毛密度\"}, {\"title\": \"出门前拍半小时衣服，一上车还是能发现新毛。\", \"dim\": \"粘附力场\"}, {\"title\": \"我的水杯、饭碗、键盘缝里，总能找到不属于我的毛发。\", \"dim\": \"粘附力场\"}, {\"title\": \"就算猫没进房间，我的被子上也永远有毛。\", \"dim\": \"粘附力场\"}, {\"title\": \"粘毛滚筒是我家仅次于厕纸的日用品。\", \"dim\": \"清理难度\"}, {\"title\": \"吸尘器滚刷上缠的毛，每次都得用剪刀剪开。\", \"dim\": \"清理难度\"}, {\"title\": \"我早就放弃了“彻底干净”这个念头。\", \"dim\": \"清理难度\"}, {\"title\": \"一到换季，我家就像下了一场鹅毛大雪。\", \"dim\": \"季节性波动\"}, {\"title\": \"春天和秋天，我家的空气净化器会显示红色预警。\", \"dim\": \"季节性波动\"}, {\"title\": \"我能通过地上的毛量，准确判断出现在是什么季节。\", \"dim\": \"季节性波动\"}, {\"title\": \"朋友来我家，第一句话通常是“哇，好多猫毛”。\", \"dim\": \"毛发存在感\"}, {\"title\": \"我手机相册里，偶尔会出现一些“背景虚化”的毛团特写。\", \"dim\": \"毛发存在感\"}, {\"title\": \"我已经习惯了在食物里发现“蛋白质纤维”加料。\", \"dim\": \"毛发存在感\"}, {\"title\": \"我觉得猫毛是家的味道，没毛反而空落落的。\", \"dim\": \"心理接受度\"}, {\"title\": \"看到毛织成的小毡子或者毛球，会觉得有点可爱。\", \"dim\": \"心理接受度\"}, {\"title\": \"掉毛就掉毛吧，反正吸进去的也是爱。\", \"dim\": \"心理接受度\"}], \"resultTypes\": [{\"name\": \"蒲公英成精\", \"emoji\": \"🌼\", \"emojiBg\": \"#FFD93D\", \"desc\": \"行走的毛球发射器。所到之处，皆是它的疆土。你家的空气里飘着的不是PM2.5，是爱的孢子。\", \"match\": \"掉毛密度\"}, {\"name\": \"强力磁毛\", \"emoji\": \"🧲\", \"emojiBg\": \"#6B7280\", \"desc\": \"你家猫的毛拥有量子纠缠般的附着力。不是毛粘上了你，是你的命运与毛绑定。放弃抵抗，接受这身天然毛衣吧。\", \"match\": \"粘附力场\"}, {\"name\": \"无效清理者\", \"emoji\": \"🌀\", \"emojiBg\": \"#A8D8EA\", \"desc\": \"你的清理工具在猫毛面前形同虚设。滚筒粘一面就满，吸尘器吸两下就堵。你不是在打扫，是在进行一场注定失败的仪式。\", \"match\": \"清理难度\"}, {\"name\": \"季节性雪崩\", \"emoji\": \"❄️\", \"emojiBg\": \"#C9C9C9\", \"desc\": \"你家有明确的“毛季”。换毛期一到，猫仿佛开启了隐形脱毛机，产量直接翻倍。恭喜你，每年体验两次极地风光。\", \"match\": \"季节性波动\"}, {\"name\": \"毛发地标\", \"emoji\": \"📍\", \"emojiBg\": \"#FF9F43\", \"desc\": \"猫毛是你家最显眼的软装。它出现在每一个角落，宣誓主权。来访者无需看见猫，就能感知到一位尊贵长毛房客的存在。\", \"match\": \"毛发存在感\"}, {\"name\": \"佛系吸毛师\", \"emoji\": \"🧘\", \"emojiBg\": \"#B5EAD7\", \"desc\": \"你已经修炼到“毛即是空，空即是毛”的境界。毛在饭里，是调味料；毛在嘴里，是缘分。这哪是掉毛，这是猫在给你织无形的羁绊。\", \"match\": \"心理接受度\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"游戏按键磨损度\", \"title\": \"你的游戏设备，被盘成什么样了？\", \"dims\": [\"WASD抛光指数\", \"摇杆掉皮速率\", \"肌肉记忆精度\", \"键位磨损分布\", \"设备寿命感知\", \"清洁维护频率\"], \"qs\": [{\"title\": \"我的键盘WASD四个键，表面字母已经磨得发白，甚至有点反光了。\", \"dim\": \"WASD抛光指数\"}, {\"title\": \"新游戏上手，我下意识会先检查默认移动键是不是WASD，不是就浑身难受。\", \"dim\": \"WASD抛光指数\"}, {\"title\": \"朋友借我键盘用，一眼就能从一堆键里精准定位到那几个油光锃亮的键。\", \"dim\": \"WASD抛光指数\"}, {\"title\": \"我的手柄摇杆橡胶套，边缘已经磨破皮，甚至能看到里面的塑料杆。\", \"dim\": \"摇杆掉皮速率\"}, {\"title\": \"激烈操作时，能感觉到拇指在磨秃了的摇杆上打滑。\", \"dim\": \"摇杆掉皮速率\"}, {\"title\": \"我换摇杆帽的频率，比换手机壳还高。\", \"dim\": \"摇杆掉皮速率\"}, {\"title\": \"闭着眼睛，我也能精准按到QERF或者手柄上的XYAB，根本不用看。\", \"dim\": \"肌肉记忆精度\"}, {\"title\": \"打游戏时，我的手指知道该去哪，脑子经常跟不上。\", \"dim\": \"肌肉记忆精度\"}, {\"title\": \"哪怕换了新键盘布局完全不同，我的手指也会在空中先做一遍习惯动作。\", \"dim\": \"肌肉记忆精度\"}, {\"title\": \"我的空格键左边比右边磨损得更厉害。\", \"dim\": \"键位磨损分布\"}, {\"title\": \"Shift键和Ctrl键的侧面，被我小拇指按出了明显的凹陷。\", \"dim\": \"键位磨损分布\"}, {\"title\": \"手柄的L2/R2肩键，弹簧声都跟刚买的时候不一样了。\", \"dim\": \"键位磨损分布\"}, {\"title\": \"我觉得一个键盘/手柄的巅峰状态，不是刚拆封，而是盘出完美包浆之后。\", \"dim\": \"设备寿命感知\"}, {\"title\": \"设备出现双击、漂移等问题，我的第一反应不是换，而是“还能再抢救一下”。\", \"dim\": \"设备寿命感知\"}, {\"title\": \"听到新设备按键清脆的“咔哒”声，反而会觉得有点陌生，不如老伙计的闷响顺手。\", \"dim\": \"设备寿命感知\"}, {\"title\": \"我的键盘缝隙里，能找到上次（或者上上次）吃零食掉进去的碎屑。\", \"dim\": \"清洁维护频率\"}, {\"title\": \"只有某个键彻底卡住按不下去了，我才会想起来清理一下。\", \"dim\": \"清洁维护频率\"}, {\"title\": \"我觉得用酒精棉片擦键盘，是对它“战斗痕迹”的一种亵渎。\", \"dim\": \"清洁维护频率\"}], \"resultTypes\": [{\"name\": \"镜面战士\", \"emoji\": \"✨\", \"emojiBg\": \"#F0F0F0\", \"desc\": \"WASD已抛光成镜，反射着无数个日夜的冲锋指令。你的移动键不是按下去的，是滑进去的。\", \"match\": \"WASD抛光指数\"}, {\"name\": \"秃杆狂魔\", \"emoji\": \"👋\", \"emojiBg\": \"#A8D8EA\", \"desc\": \"摇杆橡胶套？那是什么上古遗物？你的拇指早已与原生塑料杆融为一体，人杆合一，指哪打哪（偶尔漂移）。\", \"match\": \"摇杆掉皮速率\"}, {\"name\": \"人体外挂\", \"emoji\": \"🧠\", \"emojiBg\": \"#FF9F43\", \"desc\": \"操作已写入脊髓反射。眼睛可以看剧情，脑子可以走神，但手指永远在正确的位置执行最骚的连招。\", \"match\": \"肌肉记忆精度\"}, {\"name\": \"不对称磨损\", \"emoji\": \"⚖️\", \"emojiBg\": \"#C9C9C9\", \"desc\": \"你的设备磨损图就是你的游戏习惯侧写。空格左倾？Shift凹陷？每一个磨损点都是一场激烈团战的勋章。\", \"match\": \"键位磨损分布\"}, {\"name\": \"传家宝状态\", \"emoji\": \"🏺\", \"emojiBg\": \"#F0D9A8\", \"desc\": \"在你眼里，设备没有“报废”，只有“盘出感情”。每一个故障都是可以磨合的个性，新三年旧三年，缝缝补补又三年。\", \"match\": \"设备寿命感知\"}, {\"name\": \"战损成色\", \"emoji\": \"💥\", \"emojiBg\": \"#FFD93D\", \"desc\": \"清洁？那是对战利品的不尊重。键帽下的陈年碎屑是时间的沉淀，表面的油光是努力的证明。这才是真正的“使用感”。\", \"match\": \"清洁维护频率\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"爱豆同款相似度\", \"title\": \"你离爱豆同款有多近？\", \"dims\": [\"细节雷达灵敏度\", \"同款追踪能力\", \"应援色识别力\", \"记忆回溯深度\", \"路人辨识度\", \"消费模仿倾向\"], \"qs\": [{\"title\": \"我能一眼看出爱豆今天戴的帽子是不是三年前机场戴过的那顶。\", \"dim\": \"细节雷达灵敏度\"}, {\"title\": \"爱豆照片里一个不起眼的配饰，我能立刻在脑海里匹配上品牌和系列。\", \"dim\": \"细节雷达灵敏度\"}, {\"title\": \"看舞台直拍，我的注意力会不自觉被TA的鞋带系法、耳环晃动这些细节吸走。\", \"dim\": \"细节雷达灵敏度\"}, {\"title\": \"看到爱豆穿了一件好看的衣服，我的第一反应是去搜同款。\", \"dim\": \"同款追踪能力\"}, {\"title\": \"我手机里有个相册，专门存爱豆的穿搭，方便我对着找。\", \"dim\": \"同款追踪能力\"}, {\"title\": \"就算买不起爱豆同款，我也会找找有没有平替或者类似元素。\", \"dim\": \"同款追踪能力\"}, {\"title\": \"走在街上，看到爱豆的应援色，我会心跳加速一下。\", \"dim\": \"应援色识别力\"}, {\"title\": \"给朋友安利爱豆，我会特意强调“你看，这是TA的应援色，多特别”。\", \"dim\": \"应援色识别力\"}, {\"title\": \"选手机壳、笔记本这种日常用品，会优先考虑爱豆的应援色。\", \"dim\": \"应援色识别力\"}, {\"title\": \"我能准确说出爱豆五年前某次签售会穿了什么。\", \"dim\": \"记忆回溯深度\"}, {\"title\": \"刷到爱豆的古早视频，我能立刻想起当时发生了什么、我是什么心情。\", \"dim\": \"记忆回溯深度\"}, {\"title\": \"朋友问我爱豆的变化，我能从发型、衣品到眼神细节，分阶段讲清楚。\", \"dim\": \"记忆回溯深度\"}, {\"title\": \"我朋友说，我身上总有种“追星人”的气质，藏不住。\", \"dim\": \"路人辨识度\"}, {\"title\": \"陌生人看到我的手机壁纸或包包挂件，可能会问“你是不是喜欢XXX？”。\", \"dim\": \"路人辨识度\"}, {\"title\": \"我觉得我的审美和消费习惯，多少被爱豆影响了一些。\", \"dim\": \"路人辨识度\"}, {\"title\": \"我买过爱豆代言或推荐的东西，哪怕不是刚需。\", \"dim\": \"消费模仿倾向\"}, {\"title\": \"爱豆换了新发型，我会认真考虑自己适不适合。\", \"dim\": \"消费模仿倾向\"}, {\"title\": \"听到爱豆喜欢的歌单、推荐的书影音，我会想去试试。\", \"dim\": \"消费模仿倾向\"}], \"resultTypes\": [{\"name\": \"人形扫描仪\", \"emoji\": \"🔍\", \"emojiBg\": \"#5DADE2\", \"desc\": \"细节捕捉能力MAX。爱豆身上没有你发现不了的秘密，一根头发丝的变化都逃不过你的眼睛。你的眼睛就是尺，是行走的数据库。\", \"match\": \"细节雷达灵敏度\"}, {\"name\": \"资深代购\", \"emoji\": \"🛒\", \"emojiBg\": \"#FF6B6B\", \"desc\": \"同款追踪大师。从秀场款到小众品牌，没有你找不到的链接。你的购物车是爱豆的时尚编年史，你的收藏夹是通往TA衣橱的任意门。\", \"match\": \"同款追踪能力\"}, {\"name\": \"色感天才\", \"emoji\": \"🎨\", \"emojiBg\": \"#AB47BC\", \"desc\": \"应援色人形识别机。那抹颜色已经刻进你的DNA，成为你世界的滤镜。看到相关色系就会自动关联，并产生一种“自己人”的亲切感。\", \"match\": \"应援色识别力\"}, {\"name\": \"时光机乘客\", \"emoji\": \"⏳\", \"emojiBg\": \"#A1887F\", \"desc\": \"记忆回溯王者。你的大脑里存着爱豆的高清成长史，随时可以调取任意时间节点的影像资料。你不是在追星，你是在为TA撰写一部私人编年史。\", \"match\": \"记忆回溯深度\"}, {\"name\": \"粉籍外露型\", \"emoji\": \"🎭\", \"emojiBg\": \"#FFD93D\", \"desc\": \"粉籍写在脸上。你的热爱有形状、有颜色、有声音，无需开口，同好便能一眼认出。你的存在本身就是一句“我是TA的粉丝”。\", \"match\": \"路人辨识度\"}, {\"name\": \"沉浸式模仿者\", \"emoji\": \"🔄\", \"emojiBg\": \"#6BCF7F\", \"desc\": \"生活方式模仿家。从穿搭到爱好，你乐于让爱豆的痕迹渗透进自己的生活。这不是简单的复制，而是一种“靠近光，成为光”的实践。\", \"match\": \"消费模仿倾向\"}], \"_status\": \"success\"}, {\"prompt_version\": \"2.0\", \"tag\": \"奶茶糖分计算师\", \"title\": \"你是什么段位的奶茶鉴定师？\", \"dims\": [\"糖分感知精度\", \"配料质地雷达\", \"茶底风味记忆库\", \"点单策略复杂度\", \"复购决策周期\", \"行业黑话储备量\"], \"qs\": [{\"title\": \"喝第一口就能判断出这是三分糖还是五分糖，误差不超过0.5分。\", \"dim\": \"糖分感知精度\"}, {\"title\": \"如果店员说“今天糖浆泵可能有点不准”，我会立刻喝出来并申请重做。\", \"dim\": \"糖分感知精度\"}, {\"title\": \"朋友让我盲猜糖度，我基本没失手过。\", \"dim\": \"糖分感知精度\"}, {\"title\": \"珍珠煮得够不够糯、有没有硬芯，我咬第一颗就知道。\", \"dim\": \"配料质地雷达\"}, {\"title\": \"我能分辨出不同店的芋圆，哪家是纯芋头做的，哪家掺了太多淀粉。\", \"dim\": \"配料质地雷达\"}, {\"title\": \"奶盖是动物奶油还是植物奶油，咸甜比例对不对，我尝一口就门儿清。\", \"dim\": \"配料质地雷达\"}, {\"title\": \"我能记住常点那几家店的茶底，今天是涩了、淡了，还是火候刚好。\", \"dim\": \"茶底风味记忆库\"}, {\"title\": \"喝到一款新茶底，我能大概猜出是哪个产区的茶叶，发酵程度如何。\", \"dim\": \"茶底风味记忆库\"}, {\"title\": \"如果一家店换了茶叶供应商，我大概率是第一批发现的顾客。\", \"dim\": \"茶底风味记忆库\"}, {\"title\": \"我的点单备注经常超过三行，比如“去冰但茶底要摇匀”“珍珠换芋圆，椰果另装”。\", \"dim\": \"点单策略复杂度\"}, {\"title\": \"我会根据季节、天气和当天心情，微调糖度和冰量，有一套自己的公式。\", \"dim\": 